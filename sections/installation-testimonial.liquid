{% comment %} Soilboy {% endcomment %}
{% liquid
  assign el_id = 'installation-testimonial-' | append: section.id
  assign entry = metaobject
  assign testimonial = entry.testimonial.value
  render 'section-padding', el_id: el_id, section: section
%}

<style>
  #{{ el_id }} .it-row {
    display: flex;
    flex-direction: column-reverse;
  }
  #{{ el_id }} .it-media {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    row-gap: 8px;
  }
  #{{ el_id }} .it-media .itm-box {
    max-width: 254px;
    width: 100%;
    row-gap: 10px;
  }
  #{{ el_id }} .it-quote {
    /* text-align: right; */
  }
  @media screen and (min-width: 1024px) {
    #{{ el_id }} .it-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      column-gap: 24px;
    }
    #{{ el_id }} .it-media,
    #{{ el_id }} .it-media .itm-box {
      max-width: 330px;
      width: 100%;
    }
    #{{ el_id }} .it-quote {
      max-width: 802px;
    }
  }
</style>

<div id="{{ el_id }}">
  {% if entry != blank and testimonial != blank %}
    <div class="container">
      <div class="it-row d-pt-0 d-pb-120 pt-56 rowgap-24 pb-56 bb-1 b-main">
        <div class="it-media">
          <div class="itm-box flex flex-column rowgap-10">
            {% if testimonial.image.value != blank %}
              {% assign image_id = 'itm-image-' | append: section.id %}
              {%- render 'global-image-wrapper',
                image: testimonial.image.value,
                additional_class: 'no-bg',
                image_id: image_id
              %}
            {% endif %}
            {% render 'installation-plant-credit', credit: testimonial.plant_credit.value, index: 1 %}
          </div>
        </div>
        <div class="it-quote flex flex-column rowgap-20">
          <p class="h3 c-green no-anim">{{ testimonial.quote.value }}</p>
          {% if testimonial.attribution.value != blank %}
            <p class="p3 c-label">{{ testimonial.attribution.value }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</div>

