        { "value": "nopadding", "label": "No padding" },
        { "value": "extrasmall", "label": "Extra Small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "bottom_padding",
      "label": "Bottom padding (Desktop)",
      "options": [
        { "value": "nopadding", "label": "No padding" },
        { "value": "extrasmall", "label": "Extra Small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
