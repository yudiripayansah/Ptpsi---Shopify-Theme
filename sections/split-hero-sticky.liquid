{% comment %} Soilboy {% endcomment %}
{% liquid
    assign fn = section.id | replace: '-', ''
    assign el_id = 'split-hero-sticky-' | append: section.id
    assign ss = section.settings
    assign sb = section.blocks
    render 'section-padding', el_id: el_id, section: section
%}

<style>
    #{{ el_id }} {
        background-color: {{ section.settings.bg_color }};
    }
    #{{ el_id }} .shs-button {
        border: 1px solid var(--green);
        width: 100%;
        justify-content: space-between;
        font-size: 14px;
    }
    #{{ el_id }} .shs-button .icon,
    #{{ el_id }} .shs-button .icon svg {
        width: 16px;
        height: 16px;
    }
    #{{ el_id }} .shs-image-description {
        display: flex;
        column-gap: 24px;
    }
    #{{ el_id }} .shs-image-description .code {
        min-width: 94px;
    }
    #{{ el_id }} .shs-sticky-image {
        width: 75%;
    }
    @media screen and (min-width: 1024px){
        #{{ el_id }} .shs-button {
            max-width: 330px;
        }
        #{{ el_id }} .shs-button:hover {
            background-color: var(--green);
            color: #fff;
        }
        #{{ el_id }} .shs-button:hover .icon svg path {
            stroke: #fff;
        }
        #{{ el_id }} .shs-sticky {
            position: sticky;
            top: 40px;
        }
    }
</style>

{% if request.visual_preview_mode %}
    <img src="{{ 'split-hero-sticky-figma.PNG' | asset_url }}" width="100%" height="100%" />
{% else %}
    <div id="{{ el_id }}">
        <div class="container">
            <div class="row show-d-flex">
                <div class="col-12 col-d-4">
                    <div class="shs-sticky">
                        {% if ss.small_image != blank %}
                            <div class="shs-sticky-image mb-32 d-mb-100">
                                {%- render 'global-image-wrapper',
                                    image: ss.small_image
                                -%}
                            </div>
                        {% endif %}
                        <p class="p3 c-label">
                            {{- section.settings.subtitle -}}
                        </p>
                        <{{ section.settings.title_dom_type }} class="{{section.settings.title_size}} c-green mt-12 d-mt-16">
                            {{- section.settings.title -}}
                        </{{ section.settings.title_dom_type }}>
                        <div class="p2 c-green mt-12 d-mt-16">
                            {{- section.settings.text -}}
                        </div>
                        {% if ss.btn_label != blank %}
                            <a href="{{ ss.btn_url }}" class="shs-button p2 pt-12 pb-12 pl-24 pr-24 show-m flex mt-24 d-mt-32">
                                {{ ss.btn_label }}
                                <div class="icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                                        <path d="M5.36083 4.63917L11.448 4.63908M11.448 4.63908L11.448 10.6396M11.448 4.63908L4.3769 11.7102" stroke="#19341E" stroke-linecap="square"/>
                                    </svg>
                                </div>
                            </a>
                        {% endif %}
                    </div>
                </div>
                <div class="col-6 hide-m show-d push-d-2">
                    {% if ss.big_image != blank %}
                        {%- render 'global-image-wrapper',
                            image: ss.big_image
                        -%}
                    {% endif %}
                    {% if ss.image_label_1 != blank or ss.image_label_2 != blank %}
                        <div class="flex">
                            <div class="shs-image-description mt-8">
                                {% if ss.image_label_1 != blank %}
                                    <p class="code p4 c-label">{{ ss.image_label_1 }}</p>
                                {% endif %}
                                {% if ss.image_label_2 != blank %}
                                    <p class="name p4 c-label">{{ ss.image_label_2 }}</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endif %}

