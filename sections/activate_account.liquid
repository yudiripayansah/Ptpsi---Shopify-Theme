{% comment %} Sansandsans {% endcomment %}
{%- assign el_id = 'login-' | append: section.id -%}
{% assign ss = section.settings %}
{%- render 'section-padding', el_id: el_id, section: section -%}
<style>
  #{{el_id}} {
    padding-top: {{ ss.t_padding_m }}px;
    padding-bottom: {{ ss.b_padding_m }}px;
    background: #FFF9F2;
  }
  #{{el_id}} .global-select-div .icons .icon svg {
    width: 8px;
  }
  #{{el_id}} .label-input::placeholder {
    opacity: 1;
    color: #A4A399;
  }
  /* #{{el_id}} .submit-btn {
    width: 100%;
    padding: 12px 60px;
  } */
  #{{el_id}} #toggleIcon,
  #{{el_id}} #toggleCIcon {
    width: 24px;
    height: 24px;
    top: 50%;
    transform: translate(0, -50%);
  }
  #{{el_id}} #toggleIcon svg,
  #{{el_id}} #toggleCIcon svg {
    width: 16px;
    height: 16px;
  }
  #{{el_id}} .label-input {
    padding: 8px 24px 8px 0;
  }
  @media screen and (min-width: 600px) {
    #{{el_id}} {
      padding-top: {{ ss.t_padding_m }}px;
      padding-bottom: {{ ss.b_padding_m }}px;
    }
  }
  @media screen and (min-width: 1024px) {
    #{{el_id}} {
      padding-top: 0;
      padding-bottom: 0;
    }
    #{{el_id}} .section-padding-custom {
      padding-top: {{ ss.t_padding }}px;
      padding-bottom: {{ ss.b_padding }}px;
    }
    #{{el_id}} .submit-btn {
      width: 330px;
    }
  }
  @media screen and (min-width: 1440px) {
    #{{el_id}} .section-padding-custom {
      {% if ss.t_padding_hd != blank and ss.t_padding_hd != 0 %}
      padding-top: {{ ss.t_padding_hd }}px;
      {% endif %}
      {% if ss.b_padding_hd != blank and ss.b_padding_hd != 0 %}
      padding-bottom: {{ ss.b_padding_hd }}px;
      {% endif %}
    }
  }
  @media screen and (min-width: 1920px) {
    #{{el_id}} .section-padding-custom {
      {% if ss.t_padding_hhd != blank and ss.t_padding_hhd != 0 %}
      padding-top: {{ ss.t_padding_hhd }}px;
      {% endif %}
      {% if ss.b_padding_hhd != blank and ss.b_padding_hhd != 0 %}
      padding-bottom: {{ ss.b_padding_hhd }}px;
      {% endif %}
    }
  }
</style>
{% if request.visual_preview_mode %}
    <img src="{{ 'activate-account.PNG' | asset_url }}" width="100%" height="100%" />
{% else %}
<div id="{{ el_id }}" class="global-content-top-margin">
    <div class="container pt-16 pb-16 d-pt-24 d-pb-24">
        <div class="row ">
            <div class="col-12 col-d-1 d-mt-80">
                <h1 class="p3 c-label d-pt-12 d-pb-12">Account</h1>
            </div>
            <div class="col-12 col-d-6 mt-12 mb-40 d-mb-0 d-mt-80">
                <div class="c-green h3 no-anim c-green">
                    {{ 'customer.activate_account.title' | t }}
                </div>
                <div class="c-green p2 c-green mt-12 d-mt-16">
                    {{ 'customer.activate_account.subtext' | t }}
                </div>

                <div class="row">
                    <div class="col-12 col-d-8">
                        <div class="content-login mt-40 d-mt-60">
                        {%- form 'activate_customer_password', id: 'activate-form' -%}
                            <div class="w-full form-group mt-0">
                            <div class="relative overflow">
                                <input
                                    type="password"
                                    name="customer[password]"
                                    id="password"
                                    class="global-input w-full bb-1 b-border p2 c-black label-input"
                                    placeholder="{{ 'customer.register.password' | t }}"
                                >
                                <div
                                @click="togglePassword"
                                class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                                id="toggleIcon"
                                >
                                {{ settings.icon_hide_password }}
                                </div>
                            </div>
                            <div class="mt-4 p5 c-red error hide-m">{{ 'customer.register.register_error_pass1' | t }}</div>
                            </div>
                            <div class="w-full mt-8 d-mt-12 form-group">
                            <div class="relative overflow">
                                <input
                                    type="password"
                                    id="cpassword"
                                    name="customer[password_confirmation]"
                                    class="global-input w-full bb-1 b-border p2 c-black label-input"
                                    placeholder="{{ 'customer.register.cpassword' | t }}"
                                >
                                <div
                                @click="toggleCPassword"
                                class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                                id="toggleCIcon"
                                >
                                {{ settings.icon_hide_password }}
                                </div>
                            </div>
                            <div class="mt-4 p5 c-red error hide-m">{{ 'customer.register.register_error_pass2' | t }}</div>
                            </div>
                            <div class="mt-0">
                            <button type="submit" class="mt-24 d-mt-32 submit-btn btn1 w-full tl with-link"><span class="p2">{{- 'customer.activate_account.submit' | t -}}</span></button>
                            </div>
                        {%- endform -%}
                        </div>
                    </div>
                </div>
                {% comment %} <div class="login-container col-d-4 col-12 col-hd-4 section-padding-custom">
                    <div class="w-full">
                    <p class="p2 uppercase">{{ 'customer.activate_account.title' | t }}</p>
                    <p class="p3 pt-12">{{ 'customer.activate_account.subtext' | t }}</p>
                    <div
                        class="content-login pt-20"
                        id="login-div"
                    >
                        <div class="form-login">
                        {%- form 'activate_customer_password', id: 'activate-form' -%}
                            <div class="w-full form-group mt-0">
                            <div class="relative overflow">
                                <input
                                    type="password"
                                    name="customer[password]"
                                    id="password"
                                    class="global-input w-full bb-1 b-border p3 c-black label-input"
                                    placeholder="{{ 'customer.register.password' | t }}"
                                >
                                <div
                                @click="togglePassword"
                                class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                                id="toggleIcon"
                                >
                                {{ settings.icon_hide_password }}
                                </div>
                            </div>
                            <div class="mt-4 p5 c-red error hide-m">{{ 'customer.register.register_error_pass1' | t }}</div>
                            </div>
                            <div class="w-full mt-8 d-mt-12 form-group">
                            <div class="relative overflow">
                                <input
                                    type="password"
                                    id="cpassword"
                                    name="customer[password_confirmation]"
                                    class="global-input w-full bb-1 b-border p3 c-black label-input"
                                    placeholder="{{ 'customer.register.cpassword' | t }}"
                                >
                                <div
                                @click="toggleCPassword"
                                class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                                id="toggleCIcon"
                                >
                                {{ settings.icon_hide_password }}
                                </div>
                            </div>
                            <div class="mt-4 p5 c-red error hide-m">{{ 'customer.register.register_error_pass2' | t }}</div>
                            </div>
                            <div class="mt-0">
                            <button type="submit" class="mt-24 submit-btn btn4">{{- 'customer.activate_account.submit' | t -}}</button>
                            </div>
                        {%- endform -%}
                        </div>
                    </div>
                    </div>
                </div> {% endcomment %}
            </div>

            <div class="col-12 col-d-5">
                {% assign image_id = "login_image_1" %}
                {%- render 'global-image-wrapper-responsive',
                    image_id: image_id,
                    desktop_image: section.settings.image_desktop,
                    mobile_image: section.settings.image_mobile,
                    load_inside_vue: true
                %}
                {% if section.settings.label_1 != blank or section.settings.label_2 != blank %}
                    <div class="flex mt-8" style="gap:24px">
                        {% if section.settings.label_1 != blank %}
                            <div class="p4 c-label">{{ section.settings.label_1 }}</div>
                        {% endif %}
                        {% if section.settings.label_2 != blank %}
                            <div class="p4 c-label">{{ section.settings.label_2 }}</div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endif %}

<script>
  Vue.createApp({
    delimiters: ['${', '}'],
    data() {
      return {
        loginForm: {
          email: null,
          password: null,
          has_error: false,
          email_error: false,
          password_error: false,
        },
        resetForm: {
          email: null,
          has_error: false,
          email_error: false,
        },
        showSuccess: false,
        showReset: false,
        showLogin: true,
      };
    },
    mounted(){
      document.getElementById('activate-form').addEventListener('submit', function (e) {
        e.preventDefault();
        let passerempty = "{{'customer.register.register_error_pass1' | t}}"
        let passerconfirm = "{{'customer.register.register_error_pass2' | t}}"
        let passernotmatch = "{{'customer.register.register_error_pass3' | t}}"
    
        let passel = document.querySelector('#{{el_id}} #password')
        let cpassel = document.querySelector('#{{el_id}} #cpassword')
    
        let passfg = passel.closest('.form-group')
        let cpassfg = cpassel.closest('.form-group')
    
        let passer = passfg.querySelector('.error')
        let cpasser = cpassfg.querySelector('.error')
    
        let has_error = false;
        let pass_error = false;
        let cpass_error = false;
    
        if (!passel.value) {
          pass_error = true;
          has_error = true;
          passfg.classList.add('has-error')
          passer.classList.remove('hide-m')
        } else {
          passfg.classList.remove('has-error')
          passer.classList.add('hide-m')
        }
        if (!cpassel.value) {
          cpass_error = true;
          has_error = true;
          cpasser.innerHTML = passerconfirm
          cpassfg.classList.add('has-error')
          cpasser.classList.remove('hide-m')
        } else {
          if(cpassel.value != passel.value) {
            cpass_error = true;
            has_error = true;
            cpassfg.classList.add('has-error')
            cpasser.innerHTML = passernotmatch
            cpasser.classList.remove('hide-m')
          } else {
            cpasser.innerHTML = passerconfirm
            cpassfg.classList.remove('has-error')
            cpasser.classList.add('hide-m')
          }
        }
    
        if (has_error) {
          e.stopImmediatePropagation();
        } else {
          this.submit();
        }
      });
    },
    methods: {
      togglePassword() {
        const passwordInput = document.getElementById('password');
        const toggleIcon = document.getElementById('toggleIcon');
        const passwordType = passwordInput.type === 'password' ? 'text' : 'password';
        passwordInput.type = passwordType;

        const iconShowPassword = `{{ settings.icon_show_password }}`;
        const iconHidePassword = `{{ settings.icon_hide_password }}`;

        toggleIcon.innerHTML = passwordType === 'password' ? iconHidePassword : iconShowPassword;
      },
      toggleCPassword() {
        const passwordInput = document.getElementById('cpassword');
        const toggleIcon = document.getElementById('toggleCIcon');
        const passwordType = passwordInput.type === 'password' ? 'text' : 'password';
        passwordInput.type = passwordType;

        const iconShowPassword = `{{ settings.icon_show_password }}`;
        const iconHidePassword = `{{ settings.icon_hide_password }}`;

        toggleIcon.innerHTML = passwordType === 'password' ? iconHidePassword : iconShowPassword;
      },
    },
  }).mount('#{{ el_id }}');
</script>

