            <a href="{{ routes.account_register_url }}" class="c-placeholder h3 no-anim">
              {{- 'customer.account.create_account' | t -}}
            </a>
          </div>
          <div class="flex title-flex" v-if="showReset">
            <div class="c-green h3 no-anim">
              {{- 'customer.login.forgot_password' | t -}}
            </div>
          </div>

          <div class="row">
            <div class="col-12 col-d-8">
              <div v-if="showSuccess" id="success-div">
                <div class="h3 c-green">
                  {{ 'customer.recover_password.success' | t }}
                </div>
                <div class="mt-12 d-mt-16 p2 c-green">
                  {{ 'customer.recover_password.success_description' | t }}
                </div>
                <div class="row">
                  <div class="col-12 col-d-8">
                    <a
                      href="#"
                      rel="nofollow"
                      @click="showLoginHtml"
                      class="mt-24 d-mt-32 submit-btn btn1 w-full tl with-link"
                      ><span class="p2">{{- 'customer.account.login' | t -}}</span></a
                    >
                  </div>
                </div>
              </div>
              <div v-if="showReset" class="content-forgot mt-12 d-mt-16">
                <div class="p2 c-green">
                  {{ 'customer.recover_password.subtext' | t }}
                </div>
                {%- form 'recover_customer_password', id: 'recover-password' -%}
                  <div class="mt-40 d-mt-60">
                    <div class="relative overflow">
                      <input
                        type="email"
                        v-model="resetForm.email"
                        name="email"
                        id="email-reset-pass"
                        class="global-input w-full bb-1 b-main p2 c-black label-input"
                        placeholder="{{ 'customer.login.email' | t }}"
                      >
                    </div>
                    <div v-if="resetForm.email_error" class="mt-8 p5 c-red error">
                      {{ 'customer.recover_password.error_email' | t }}
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-12 col-d-8">
                      <div class="mt-24 d-mt-32">
                        <button type="submit" @click="checkResetPassword" class="submit-btn btn1 w-full tl with-link">
                          {{ 'customer.reset_password.title' | t }}
                        </button>
                        {% comment %}
                          <li class="flex ai-center d-ml-20 mt-12 d-mt-0 flex jc-center d-jc-start">
                          <a href="#" @click="showLoginHtml" rel="nofollow" class="p3 link4 c-black" id="forgot-link">
                              {{- 'customer.account.cancel' | t -}}
                          </a>
                          </li>
                        {% endcomment %}
                      </div>
                      <p class="p5 error-message-forgot c-red mt-10 hide-m"></p>
                      <input type="hidden" name="return_to" value="{{ routes.account_login_url }}#recover-success">
                      <div class="mt-12">
                        <a href="#" @click="showLoginHtml" rel="nofollow" class="p2 c-green underline">
                          {{- 'customer.recover_password.back_to_login' | t -}}
                        </a>
                      </div>
                    </div>
                  </div>
                {%- endform -%}
              </div>
              <div class="content-login mt-40 d-mt-60 " v-if="showLogin">
                <div class="form-login">
                  {%- form 'customer_login' -%}
                    <div class="w-full">
                      <div class="relative overflow pb-1">
                        <input
                          type="email"
                          v-model="loginForm.email"
                          name="customer[email]"
                          id="email"
                          class="global-input w-full bb-1 b-main p2 c-green label-input"
                          placeholder="{{ 'customer.login.email' | t }}"
                        >
                      </div>
                      <div v-if="loginForm.email_error" class="mt-8 p5 c-red error ">
                        {{ 'customer.login.error_email' | t }}
                      </div>
                    </div>
                    <div class="w-full mt-12">
                      <div class="relative overflow pb-1">
                        <input
                          type="password"
                          v-model="loginForm.password"
                          name="customer[password]"
                          id="password"
                          class="global-input w-full bb-1 b-main p2 c-green label-input"
                          placeholder="{{ 'customer.login.password' | t }}"
                        >
                        <div
                          @click="togglePassword"
                          class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                          id="toggleIcon"
                        >
                          {{ settings.icon_hide_password }}
                        </div>
                      </div>
                      <div v-if="loginForm.password_error" class="mt-8 p5 c-red error ">
                        {{ 'customer.login.error_password' | t }}
                      </div>

                      {%- if form.errors -%}
                        <div class="form-errors rte mt-8 p5 c-red">
                          {{ form.errors | default_errors }}
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="row">
                      <div class="col-12 col-d-8">
                        <button type="submit" class="mt-24 d-mt-32 submit-btn btn1 w-full tl with-link">
                          <span class="p2">{{- 'customer.account.login' | t -}}</span>
                        </button>
                      </div>
                    </div>

                    <div class="mt-12">
                      <a href="#" @click="showResetHtml" rel="nofollow" class="p2 c-green underline" id="forgot-link">
                        {{- 'customer.login.forgot_password' | t -}}
                      </a>
                    </div>
                    <p class="p5 error-message c-red mt-10 hide-m"></p>
                  {%- endform -%}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-d-5">
          {% assign image_id = 'login_image_1' %}
          {%- render 'global-image-wrapper-responsive',
            image_id: image_id,
            desktop_image: section.settings.image_desktop,
            mobile_image: section.settings.image_mobile,
            load_inside_vue: true
          %}
          {% if section.settings.label_1 != blank or section.settings.label_2 != blank %}
            <div class="flex mt-8" style="gap:24px">
              {% if section.settings.label_1 != blank %}
                <div class="p4 c-label">{{ section.settings.label_1 }}</div>
              {% endif %}
              {% if section.settings.label_2 != blank %}
                <div class="p4 c-label">{{ section.settings.label_2 }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>

