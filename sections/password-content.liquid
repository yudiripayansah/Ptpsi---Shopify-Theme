{%- assign el_id = 'password-content-' | append: section.id -%}
{%- assign ss = section.settings -%}
<style>
  body {
    background-image:url("https://cdn.shopify.com/s/files/1/0628/8559/3228/files/Screenshot_2025-04-22_at_20.56.50.jpg?v=1745330236");
    background-repeat: repeat;
    background-size: 160px 160px;
  }

  #{{ el_id }} .password-page {
    box-sizing: border-box;
    padding: 60px 16px 80px;
    background-image: url("{{ ss.image_mobile | img_url: '2000x' }}");
    background-size: cover;
    background-position: center center;
  }
  #{{ el_id }} .password-page:before {
    display: none;
  }
  #{{ el_id }} .password-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .2);
    pointer-events: none;
  }
  #{{ el_id }} .password-logo {
    position: absolute;
    top: 60px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    z-index: 2;
  }
  #{{ el_id }} .password-logo .global-image-wrapper .image {
    object-fit: contain;
  }
  #{{ el_id }} .password-details {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 343px;
  }
  #{{ el_id }} .password-input {
    background: transparent;
    border: none;
    outline: none;
    width: 100%;
  }
  #{{ el_id }} .password-input::placeholder {
    color: inherit;
    opacity: 1;
  }
  #{{ el_id }} .password-submit {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    white-space: nowrap;
  }
  @media only screen and (min-width: 1024px) {
    #{{ el_id }} .password-page {
      padding: 60px 80px 80px;
      background-image: url("{{ ss.image | img_url: '5000x' }}");
    }
    #{{ el_id }} .password-logo {
      width: 101px;
    }
    #{{ el_id }} .password-details {
      max-width: 448px;
    }
  }
</style>
<section id="{{el_id}}">
  <div class="password-page">
    <div class="password-overlay"></div>
    {% if ss.logo_desktop != blank or ss.logo_mobile != blank %}
      <div class="password-logo">
        {%- assign logo_image_id = 'password-logo-' | append: section.id -%}
        {%- render 'global-image-wrapper-responsive',
          image_id: logo_image_id,
          desktop_image: ss.logo_desktop,
          mobile_image: ss.logo_mobile,
          image_change_breakpoint: 'desktop',
          preload: true
        -%}
      </div>
    {% endif %}
    <div class="password-details text-center flex flex-column ai-center rowgap-32 d-rowgap-40">
      {% if ss.title != blank or ss.text != blank %}
        <div class="flex flex-column ai-center rowgap-12 d-rowgap-16 w-full">
          {% if ss.title != blank %}
            <h1 class="{{ ss.title_size }} c-white no-anim tc">{{ ss.title }}</h1>
          {% endif %}
          {% if ss.text != blank %}
            <div class="rte p2 c-white tc">
              <p>{{ ss.text | newline_to_br }}</p>
            </div>
          {% endif %}
        </div>
      {% endif %}
      {% if ss.password %}
        {% form 'storefront_password',
          class: 'password-field w-full flex ai-center jc-between colgap-24 bb-1 b-secondary pt-8 pb-8'
        %}
          <input
            type="password"
            name="password"
            id="Password"
            class="password-input p2 c-placeholder"
            placeholder="Password"
          >
          <button type="submit" class="password-submit p2 c-white">Submit</button>
        {% endform %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Password Page Content",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_desktop",
      "label": "Logo (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Logo (Mobile)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title Size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "password",
      "label": "Show password form",
      "default": true
    }
  ]
}
{% endschema %}
