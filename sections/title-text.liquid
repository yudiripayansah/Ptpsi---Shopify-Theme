{% comment %} Soilboy {% endcomment %}
{% liquid
  assign fn = section.id | replace: '-', ''
  assign el_id = 'split-hero-accordion-' | append: section.id
  assign ss = section.settings
  assign sb = section.blocks
  render 'section-padding', el_id: el_id, section: section
%}

<style>
  #{{ el_id }} {
    background-color: {{ section.settings.bg_color }};
  }
  #{{el_id}} .content-part .rte li {
    margin-bottom: 4px;
  }
  @media screen and (min-width: 1024px){
  }
</style>

{% if request.visual_preview_mode %}
  <img src="{{ 'title-text.png' | asset_url }}" width="100%" height="100%">
{% else %}
  <div id="{{ el_id }}" class="relative">
    <div class="container">
      <div class="d-max-920 ml-auto mr-auto w-full">
        <{{ ss.title_dom_type }} class="{{ ss.title_size }}">
          {{- ss.title | newline_to_br -}}
        </{{ ss.title_dom_type }}>
        <div class="d-mt-80 mt-48 flex flex-column d-rowgap-40 rowgap-32">
          {% for block in sb %}
            {% assign bs = block.settings %}
            <div class="flex d-flex-row flex-column ai-start jc-between rowgap-12 d-colgap-24 {% unless forloop.last == true %} pb-32 d-pb-40 bb-1 b-main {% endunless %}">
              <div class="title-part d-max-330 w-full">
                <div class="h4">
                  {{ bs.title }}
                </div>
              </div>
              <div class="content-part w-full">
                <div class="rte p2 c-green">
                  {{ bs.text }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

