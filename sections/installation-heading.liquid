{% comment %} Soilboy {% endcomment %}
{% liquid
  assign el_id = 'installation-heading-' | append: section.id
  assign ss = section.settings
  render 'section-padding', el_id: el_id, section: section
%}

<style>
  #{{ el_id }} {
    background-color: {{ ss.bg_color }};
  }
  #{{ el_id }} .ih-title,
  #{{ el_id }} .ih-text {
    color: var(--green);
  }
  #{{ el_id }} .ih-text {
    margin-top: 16px;
  }
  @media screen and (min-width: 1024px) {
    #{{ el_id }} .ih-text {
      margin-top: 32px;
    }
  }
</style>

{% if request.visual_preview_mode %}
  <img src="{{ 'installation-heading.png' | asset_url }}" width="100%" height="100%">
{% else %}
  <div id="{{ el_id }}" class="relative">
    <div class="container">
      <{{ ss.title_dom_type }} class="{{ ss.title_dom_size }} ih-title">
        {{- ss.title | newline_to_br -}}
      </{{ ss.title_dom_type }}>
      {% if ss.text != blank %}
        <div class="rte p1 ih-text">
          {{ ss.text }}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

