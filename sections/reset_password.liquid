{% comment %} Luxlexicon Theme - junio done {% endcomment %}
{% assign el_id = 'reset-password-' | append: section.id %}
{% assign ss = section.settings %}
{% render 'section-padding', section: section, el_id: el_id %}
<style>
  #{{el_id}} {
    padding-top: {{ ss.t_padding_m }}px;
    padding-bottom: {{ ss.b_padding_m }}px;
    background: #FFF9F2;
  }
  #{{el_id}} .c-red {
    color: #ac1e15;
  }
  #{{el_id}} .label-input::placeholder {
    opacity: 1;
    color: #A4A399;
  }
  #{{el_id}} .global-select-div .icons .icon svg {
    width: 8px;
  }
  {% comment %} #{{el_id}} .submit-btn {
    width: 100%;
    padding: 12px 60px;
  } {% endcomment %}
  #{{el_id}} #toggleIcon,
  #{{el_id}} #toggleCIcon {
    width: 24px;
    height: 24px;
    top: 50%;
    transform: translate(0, -50%);
  }
  #{{el_id}} #toggleIcon svg,
  #{{el_id}} #toggleCIcon svg {
    width: 16px;
    height: 16px;
  }
  #{{el_id}} .label-input {
    padding: 8px 24px 8px 0;
  }
  @media screen and (min-width: 600px) {
    #{{el_id}} {
      padding-top: {{ ss.t_padding_m }}px;
      padding-bottom: {{ ss.b_padding_m }}px;
    }
  }
  @media screen and (min-width: 1024px) {
    #{{el_id}} {
      padding-top: 0;
      padding-bottom: 0;
    }
    #{{el_id}} .section-padding-custom {
      padding-top: {{ ss.t_padding }}px;
      padding-bottom: {{ ss.b_padding }}px;
    }
    #{{el_id}} .submit-btn {
      width: 330px;
    }
  }
  @media screen and (min-width: 1440px) {
    #{{el_id}} .section-padding-custom {
      {% if ss.t_padding_hd != blank and ss.t_padding_hd != 0 %}
      padding-top: {{ ss.t_padding_hd }}px;
      {% endif %}
      {% if ss.b_padding_hd != blank and ss.b_padding_hd != 0 %}
      padding-bottom: {{ ss.b_padding_hd }}px;
      {% endif %}
    }
  }
  @media screen and (min-width: 1920px) {
    #{{el_id}} .section-padding-custom {
      {% if ss.t_padding_hhd != blank and ss.t_padding_hhd != 0 %}
      padding-top: {{ ss.t_padding_hhd }}px;
      {% endif %}
      {% if ss.b_padding_hhd != blank and ss.b_padding_hhd != 0 %}
      padding-bottom: {{ ss.b_padding_hhd }}px;
      {% endif %}
    }
  }
</style>
{% comment %}
  <div id="{{ el_id }}">
    <div class="container">
      <div class="flex jc-center row ">
        <div class="reset-password-page col-d-4 col-12 col-hd-4 col-hhd-4 section-padding-custom">
          <div class="w-full">
            <p class="p2 uppercase">{{ 'customer.reset_password.title' | t }}</p>
            <div
              class="content-login pt-20"
            >
              <div id="reset-div" class="form-login">
                {%- form 'reset_customer_password', id: 'reset-password-form' -%}
                  <div class="w-full form-group mt-0">
                    <div class="relative overflow">
                      <input
                          type="password"
                          v-model="password"
                          name="customer[password]"
                          id="password"
                          class="global-input w-full bb-1 b-border p3 c-black label-input"
                          placeholder="{{ 'customer.reset_password.password' | t }}"
                      >
                      <div
                        @click="togglePassword"
                        class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                        id="toggleIcon"
                      >
                        {{ settings.icon_hide_password }}
                      </div>
                    </div>
                    <div v-if="password_error" class="mt-4 p5 c-red error">
                      {{ 'customer.reset_password.error_password' | t }}
                    </div>
                  </div>
                  <div class="w-full mt-8 d-mt-12 form-group">
                    <div class="relative overflow">
                      <input
                          type="password"
                          v-model="password_confirm"
                          name="customer[password_confirmation]"
                          id="password_confirmation"
                          class="global-input w-full bb-1 b-border p3 c-black label-input"
                          placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
                      >
                      <div
                        @click="toggleCPassword"
                        class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                        id="toggleCIcon"
                      >
                        {{ settings.icon_hide_password }}
                      </div>
                    </div>
                    <div v-if="password_confirm_error" class="mt-4 p5 c-red error">
                      {{ 'customer.reset_password.error_password_confirm' | t }}
                    </div>
                    <div v-if="password_not_match" class="mt-4 p5 c-red error">
                      {{ 'customer.register.register_error_pass3' | t }}
                    </div>

                  </div>
                  <div class="mt-0">
                    <button type="submit" class="mt-20 submit-btn btn4">{{ 'customer.reset_password.submit' | t }}</button>
                  </div>
              {%- endform -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endcomment %}
{% if request.visual_preview_mode %}
  <img src="{{ 'activate-account.PNG' | asset_url }}" width="100%" height="100%" />
{% else %}
  <div id="{{ el_id }}" class="global-content-top-margin">
    <div class="container pt-16 pb-16 d-pt-24 d-pb-24 reset-password-page">
      <div class="row ">
        <div class="col-12 col-d-1 d-mt-80">
          <h1 class="p3 c-label d-pt-12 d-pb-12">Account</h1>
        </div>
        <div class="col-12 col-d-6 mt-12 mb-40 d-mb-0 d-mt-80">
          <div class="c-green h3 no-anim c-green">
            {{ 'customer.activate_account.title' | t }}
          </div>
          <div class="c-green p2 c-green mt-12 d-mt-16">
            {{ 'customer.activate_account.subtext' | t }}
          </div>

          <div class="row">
            <div class="col-12 col-d-8">
              <div class="content-login mt-40 d-mt-60">
                {%- form 'reset_customer_password', id: 'reset-password-form' -%}
                  <div class="w-full form-group mt-0">
                    <div class="relative overflow">
                      <input
                        type="password"
                        v-model="password"
                        name="customer[password]"
                        id="password"
                        class="global-input w-full bb-1 b-border p2 c-black label-input"
                        placeholder="{{ 'customer.reset_password.password' | t }}"
                      >
                      <div
                        @click="togglePassword"
                        class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                        id="toggleIcon"
                      >
                        {{ settings.icon_hide_password }}
                      </div>
                    </div>
                    <div v-if="password_error" class="mt-4 p5 c-red error">
                      {{ 'customer.reset_password.error_password' | t }}
                    </div>
                  </div>
                  <div class="w-full mt-8 d-mt-12 form-group">
                    <div class="relative overflow">
                      <input
                        type="password"
                        v-model="password_confirm"
                        name="customer[password_confirmation]"
                        id="password_confirmation"
                        class="global-input w-full bb-1 b-border p2 c-black label-input"
                        placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
                      >
                      <div
                        @click="toggleCPassword"
                        class="pointer absolute right-0 bottom-0 h-full flex ai-center p-4"
                        id="toggleCIcon"
                      >
                        {{ settings.icon_hide_password }}
                      </div>
                    </div>
                    <div v-if="password_confirm_error" class="mt-4 p5 c-red error">
                      {{ 'customer.reset_password.error_password_confirm' | t }}
                    </div>
                    <div v-if="password_not_match" class="mt-4 p5 c-red error">
                      {{ 'customer.register.register_error_pass3' | t }}
                    </div>
                  </div>
                  <div class="mt-0">
                    <button type="submit" class="tl mt-24 d-mt-32 submit-btn btn1 w-full with-link">
                      <span class="p2">{{ 'customer.reset_password.submit' | t }}</span>
                    </button>
                  </div>
                {%- endform -%}
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-d-5">
          {% assign image_id = 'login_image_1' %}
          {%- render 'global-image-wrapper-responsive',
            image_id: image_id,
            desktop_image: section.settings.image_desktop,
            mobile_image: section.settings.image_mobile,
            load_inside_vue: true
          %}
          {% if section.settings.label_1 != blank or section.settings.label_2 != blank %}
            <div class="flex mt-8" style="gap:24px">
              {% if section.settings.label_1 != blank %}
                <div class="p4 c-label">{{ section.settings.label_1 }}</div>
              {% endif %}
              {% if section.settings.label_2 != blank %}
                <div class="p4 c-label">{{ section.settings.label_2 }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

<script>
  Vue.createApp({
    delimiters: ['${', '}'],
    data() {
      return {
        password: null,
        password_confirm: null,
        has_error: false,
        password_error: false,
        password_confirm_error: false,
        password_not_match: false,
      };
    },
    mounted() {
      const thisObj = this;
      document.getElementById('reset-password-form').addEventListener('submit', function (e) {
        e.preventDefault();

        thisObj.has_error = false;
        thisObj.password_error = false;
        thisObj.password_confirm_error = false;
        thisObj.password_not_match = false;

        if (!thisObj.password) {
          thisObj.password_error = true;
          thisObj.has_error = true;
        }

        if (!thisObj.password_confirm) {
          thisObj.password_confirm_error = true;
          thisObj.has_error = true;
        }
        if (thisObj.password != thisObj.password_confirm) {
          thisObj.has_error = true;
          if (thisObj.password && thisObj.password_confirm) {
            thisObj.password_not_match = true;
          }
        }

        if (!thisObj.has_error) {
          this.submit();
        }
      });
    },
    methods: {
      togglePassword() {
        const passwordInput = document.getElementById('password');
        const toggleIcon = document.getElementById('toggleIcon');
        const passwordType = passwordInput.type === 'password' ? 'text' : 'password';
        passwordInput.type = passwordType;

        const iconShowPassword = `{{ settings.icon_show_password }}`;
        const iconHidePassword = `{{ settings.icon_hide_password }}`;

        toggleIcon.innerHTML = passwordType === 'password' ? iconHidePassword : iconShowPassword;
      },
      toggleCPassword() {
        const passwordInput = document.getElementById('password_confirmation');
        const toggleIcon = document.getElementById('toggleCIcon');
        const passwordType = passwordInput.type === 'password' ? 'text' : 'password';
        passwordInput.type = passwordType;

        const iconShowPassword = `{{ settings.icon_show_password }}`;
        const iconHidePassword = `{{ settings.icon_hide_password }}`;

        toggleIcon.innerHTML = passwordType === 'password' ? iconHidePassword : iconShowPassword;
      },
    },
  }).mount('.reset-password-page');
</script>

{% schema %}
{
  "name": "Reset Password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image Mobile"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Label 1"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Label 2"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "number",
      "id": "t_padding_m",
      "label": "Top padding (Mobile)",
      "default": 0
    },
    {
      "type": "number",
      "id": "b_padding_m",
      "label": "Bottom padding (Mobile)",
      "default": 0
    },
    {
      "type": "number",
      "id": "t_padding_t",
      "label": "Top padding (Tablet)",
      "default": 0
    },
    {
      "type": "number",
      "id": "b_padding_t",
      "label": "Bottom padding (Tablet)",
      "default": 0
    },
    {
      "type": "number",
      "id": "t_padding",
      "label": "Top padding (Desktop)",
      "default": 0
    },
    {
      "type": "number",
      "id": "b_padding",
      "label": "Bottom padding (Desktop)",
      "default": 0
    },
    {
      "type": "number",
      "id": "t_padding_hd",
      "label": "Top padding (HD",
      "default": 0
    },
    {
      "type": "number",
      "id": "b_padding_hd",
      "label": "Bottom padding (HD)",
      "default": 0
    },
    {
      "type": "number",
      "id": "t_padding_hhd",
      "label": "Top padding (HHD",
      "default": 0
    },
    {
      "type": "number",
      "id": "b_padding_hhd",
      "label": "Bottom padding (HHD)",
      "default": 0
    }
  ]
}
{% endschema %}
