{% comment %} Soilboy {% endcomment %}
{% liquid
  assign el_id = 'installation-hero-' | append: section.id
  assign ss = section.settings
  assign entry = metaobject
  render 'section-padding', el_id: el_id, section: section

  comment
    An unset url-type setting resolves to shop.url rather than truly blank,
    so `| default:` alone won't catch it — same quirk fixed in
    installation-intro.liquid and installation-list-item-featured.liquid.
  endcomment
  assign back_link_url = ss.back_link_url
  if back_link_url == blank or back_link_url == shop.url
    assign back_link_url = '/pages/installation-case-study'
  endif
%}

<style>
  #{{el_id}} .container:before,
  #{{el_id}} .container:after {
    display: none;
  }
  #{{ el_id }} .ih-image {
    overflow: hidden;
  }
  #{{ el_id }} .ih-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #{{ el_id }} .ih-back {
    column-gap: 4px;
    text-decoration: underline;
  }
  #{{ el_id }} .ih-back-icon svg {
    width: 16px;
    height: 16px;
  }
  #{{ el_id }} .ih-back-icon svg {
    width: 9px;
    height: 9px;
  }
  @media screen and (min-width: 1024px) {
    #{{ el_id }} .ih-image {
      aspect-ratio: 1392 / 550;
    }
    #{{ el_id }} .ih-back {
    }
  }
</style>

<div id="{{ el_id }}">
  {% if entry == blank %}
    {% if request.design_mode %}
      <div class="container">
        <p class="p2 c-label">This section only renders on an Installation metaobject page.</p>
      </div>
    {% endif %}
  {% else %}
    <div class="container flex flex-column rowgap-16 pt-16 d-pt-0">
      {% if entry.hero_image.value != blank %}
        <div class="ih-image">
          {% assign image_id = "ih-hero" | append: el_id %}
          {%- render 'global-image-wrapper-responsive',
              image_id: image_id,
              desktop_image: entry.hero_image.value,
              mobile_image: entry.card_image.value
          %}
        </div>
      {% endif %}
      <a href="{{ back_link_url }}" class="ih-back p2 c-green flex ai-center colgap-4">
        <span class="icon flex ai-center jc-center ih-back-icon">{{ settings.icon_slide_left }}</span>
        {{ ss.back_link_label | default: 'Back to Installations' }}
      </a>
    </div>
  {% endif %}
</div>

