{% comment %}
  Client/partner logo wall: a continuous CSS marquee (not Swiper — this is a passive,
  non-interactive decorative scroll, the same distinction Horizon's own `marquee.liquid`
  makes versus its carousel/slideshow sections). Pauses on hover; respects reduced motion.
  Logos are classic section blocks, shown in full color (matches the reference).
{% endcomment %}

<section
  class="company-logo-wall py-12 sm:py-16"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="mb-8 px-5 text-center text-xs font-semibold uppercase tracking-[0.2em] opacity-60 sm:mb-10 sm:px-8">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  <div class="company-logo-wall__viewport group overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
    <div class="company-logo-wall__track flex w-max items-center gap-10 group-hover:[animation-play-state:paused]">
      {%- for copy in (1..2) -%}
        <div class="flex shrink-0 items-center gap-10" aria-hidden="{% if copy == 2 %}true{% else %}false{% endif %}">
          {%- for block in section.blocks -%}
            {% render 'company-logo-item', image: block.settings.image, alt: block.settings.alt %}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="mt-10 flex justify-center sm:mt-14">
      {% render 'company-button', label: section.settings.button_label, url: section.settings.button_link, bg: section.settings.accent_color, color: '#ffffff' %}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .company-logo-wall__track {
    animation: company-logo-wall-scroll 28s linear infinite;
  }

  @keyframes company-logo-wall-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .company-logo-wall__track {
      animation: none;
    }
    .company-logo-wall__viewport {
      overflow-x: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo wall",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by leading venues & retailers" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See clients" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#c23a3a" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "alt", "label": "Client name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo wall",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
