                                color: color,
                                id: idsPlanter[i],
                                price: pricesPlanter[i],
                                availability: availabilityPlanter[i]
                            });
                        });
                        
                        let resultPlanter = planterMap.find(item => pdpNormColor(item.color) === pdpNormColor(chosenColor.innerHTML));
                        planterAvailability = resultPlanter?.availability === 'true';
                        console.log('checkplanteravailability', planterAvailability, resultPlanter);
                    }
                    if(chosenSaucer){
                        let idsSaucer = chosenSaucer.dataset.saucerVariant.split('|');
                        let colorsSaucer = JSON.parse(atob(chosenSaucer.dataset.saucerColor));
                        let pricesSaucer = chosenSaucer.dataset.saucerPrice.split('|').map(Number);
                        let availabilitySaucer = chosenSaucer.dataset.availability.split('|');

                        let saucerMap = [];

                        colorsSaucer.forEach((color, i) => {
                            saucerMap.push({
                                color: color,
                                id: idsSaucer[i],
                                price: pricesSaucer[i],
                                availability: availabilitySaucer[i]
                            });
                        });
                        
                        let resultSaucer = saucerMap.find(item => pdpNormColor(item.color) === pdpNormColor(chosenColor.innerHTML));
                        saucerAvailability  = resultSaucer?.availability === 'true';
                        console.log('saucerAvailability', chosenColor.innerHTML, saucerMap);
                    }
                    const pdp_top_atc_nodes = document.querySelectorAll('.pdp-top-atc');
                    let planter_wrapper =  document.querySelector('.planter-accordion-wrapper');
                    let saucer_wrapper =  document.querySelector('.saucer-accordion-wrapper');
                    let color_availability =  document.querySelector('.pdpb-color.hidden');
                    if (planter_wrapper || saucer_wrapper){
                        if(chosenPlanter) {
                            console.log('planter availability', chosenPlanter, planterAvailability);
                            if(!planterAvailability) {
                                this.disableButton("Sold Out");
                                return;
                            } else {
                                this.activateButton();
                                if(!saucerAvailability && chosenSaucer) {
                                    if(trigger !== 'sauceroff' && trigger !== 'changecolor') {
                                        this.disableButton("Sold Out");
                                        return;
                                    }
                                } else {
                                    this.activateButton();
                                }
                            }
                        } else if (chosenSaucer) {
                            if(!saucerAvailability) {
                                this.activateButton();
                                if(trigger !== 'sauceroff') {
                                    this.disableButton("Sold Out");
                                    return;
                                }
                            } else {
                                this.activateButton();
                            }
                        }
                    } else {
                        if(color_availability.getAttribute("data-availability") === 'false') {
                            this.disableButton("Sold Out");
                            return;
                        } else {
                            this.activateButton();
                        }
                    }
                }
            },
            addToCartGC(e) {
                const this_obj = this;
                e.preventDefault();
                
                const atc_button = document.querySelector(`.pdp-top-atc`);
                let form = document.querySelector(`.pdp-top-gift-form`);
                    var parentVariantId = form.querySelector('.pdp-top-variant-id') ? form.querySelector('.pdp-top-variant-id').value : null
                    let properties = {}
                    let payload = {
                        qty: 1,
                        variantId: Number(parentVariantId),
                        button: atc_button
                    }
                    const nonce = new Date().getTime() + Math.floor(Math.random() * 100000);
                    {% if product.gift_card? or product.type == 'Gift Card' %}
                        /* get properties */
                        let msg_email_empty = "{{ 'products.product.please_enter' | t }} {{ 'products.product.recipient_email' | t }}"
                        let msg_email_invalid = "{{ 'customer.register.error_valid_email' | t }}"
                        const sender_name_el = document.querySelector('input[name="properties[Sender name]"]');
                        const recipient_name_el = document.querySelector('input[name="properties[Recipient name]"]');
                        const recipient_email_el = document.querySelector('input[name="properties[Recipient email]"]');
                        const message_el = document.querySelector('textarea[name="properties[Message]"]');
                        const send_date_el = document.querySelector('input[name="properties[Send on]"]');
                        const sender_name = sender_name_el.value;
                        const recipient_name = recipient_name_el.value;
                        const recipient_email = recipient_email_el.value;
                        const message = message_el.value;
                        const send_date = send_date_el.value;
                        let err_sn = sender_name_el.closest('.form-group').querySelector('.error-message')
                        let err_rn = recipient_name_el.closest('.form-group').querySelector('.error-message')
                        let err_re = recipient_email_el.closest('.form-group').querySelector('.error-message')
                        if(sender_name && recipient_name && recipient_email){
                            if(this.checkEmail(recipient_email)){
                                err_sn.classList.add('hide-m')
                                err_rn.classList.add('hide-m')
                                err_re.innerHTML = msg_email_empty
                                err_re.classList.add('hide-m')
                                properties['__shopify_send_gift_card_to_recipient'] = 'on'
                                properties["Sender name"] = sender_name
                                properties["Recipient name"] = recipient_name
                                properties["Recipient email"] = recipient_email
                                properties["Message"] = message
                                properties["Send on"] = send_date
                                properties["_temp_parent_nonce"] = nonce
                                properties["_is_parent"] = true
                                properties["_parent_id"] = nonce
                                payload.properties = properties
                                $360.addToCart(payload,function() { $360.refreshCartPage();/*initSwiperYmal()*/});
                            } else {
                                if(err_sn){
                                    if(!sender_name){
                                        err_sn.classList.remove('hide-m')
                                    } else {
                                        err_sn.classList.add('hide-m')
                                    }
                                }
                                if(err_rn){
                                    if(!recipient_name){
                                        err_rn.classList.remove('hide-m')
                                    } else {
                                        err_rn.classList.add('hide-m')
                                    }
                                }
                                err_re.innerHTML = msg_email_invalid
                                err_re.classList.remove('hide-m')
                            }
                        } else {
                            if(err_sn){
                                if(!sender_name){
                                    err_sn.classList.remove('hide-m')
                                } else {
                                    err_sn.classList.add('hide-m')
                                }
                            }
                            if(err_rn){
                                if(!recipient_name){
                                    err_rn.classList.remove('hide-m')
                                } else {
                                    err_rn.classList.add('hide-m')
                                }
                            }
                            if(err_re){
                                if(!recipient_email){
                                    err_re.classList.remove('hide-m')
                                } else {
                                    if(this.checkEmail(recipient_email)){
                                        err_re.innerHTML = msg_email_empty
                                        err_re.classList.add('hide-m')
                                    } else {
                                        err_re.innerHTML = msg_email_invalid
                                        err_re.classList.remove('hide-m')
                                    }
                                }
                            }
                        }
                    {% else %}
                        if(properties) {
                            payload.properties = properties
                        }
                        $360.addToCart(payload,function() { $360.refreshCartPage();/*initSwiperYmal()*/});
                    {% endif %}
            },
            isValidEmail(e) {
                const elem = e.target
                const email = elem.value
                const parent = elem.closest('.form-group');
                const error_elem = parent.querySelector('.error-message');

                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                let msg_email_empty = "{{ 'products.product.please_enter' | t }} {{ 'products.product.recipient_email' | t }}"
                let msg_email_invalid = "{{ 'customer.register.error_valid_email' | t }}"
                if(!this.checkEmail(email)) {
                    error_elem.innerHTML = msg_email_invalid
                    error_elem.classList.remove('hide-m');
                } else {
                    error_elem.innerHTML = msg_email_empty
                    error_elem.classList.add('hide-m')
                }
            },
            checkEmail(email){
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                console.log(emailRegex.test(email),"test");
                if(email != '') {
                    if(emailRegex.test(email)) {
                        return true;
                    } else {
                        return false;
                    }
                } else {
                    return false;
                }
            },
            async submitForm(e) {
                e.preventDefault();
                var form = document.querySelector('.pdp-top-atc-form');
                var button = document.querySelector('.pdp-top-atc');
                var buttons = document.querySelectorAll('.pdp-top-atc');
                if(!form) return;

                // var saucerId = document.querySelector('.pdpb-saucer.active') ? document.querySelector('.pdpb-saucer.active').getAttribute("data-saucer-variant") : '';
                var planterId = document.querySelector('.pdpb-color.hidden') ? document.querySelector('.pdpb-color.hidden').getAttribute("data-variant") : null;
                // No colour chosen (e.g. planter & saucer share none): fall back to the active
                // planter's first variant so it can still be added to cart.
                if (!planterId) {
                    var _activePlanterForId = document.querySelector('.pdpb-planter.active');
                    if (_activePlanterForId && _activePlanterForId.dataset.colorVariant) {
                        planterId = _activePlanterForId.dataset.colorVariant.split('|')[0] || null;
                    }
                }
                var parentVariantId = form.querySelector('.pdp-top-variant-id') ? form.querySelector('.pdp-top-variant-id').value : null;
                var saucerTitle  = document.querySelector('.saucer-title-holder');
                {% unless product.tags contains 'plants' %}
                    parentVariantId = document.querySelector('.pdpb-color.hidden') ? document.querySelector('.pdpb-color.hidden').getAttribute("data-variant") : null;
                {% endunless %}
                if(!parentVariantId) { form.submit(); return; }

                // If no saucer selected/resolved, perform normal submit
                {% comment %} if(!saucerId) {
                    var button = document.querySelector('.pdp-top-atc');
                    let prev_text = button.innerHTML;
                    let payload = {
                        qty: 1,
                        variantId: Number(parentVariantId),
                        button: button
                    }
                    $360.addToCart(payload,function() { $360.refreshCartPage();});
                    return;
                } {% endcomment %}

                try {
                    let prev_text = button.innerHTML;
                    // Create a unique nonce to identify the parent line item in the cart
                    const nonce = new Date().getTime() + Math.floor(Math.random() * 100000);
                    buttons.forEach((buttonnode) => {
                        buttonnode.innerHTML = `<span class="w-full tc">Adding...</span>`;
                    });

                    // 1) Add parent product with a temporary identifying property
                    await fetch('/cart/add.js', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            id: Number(parentVariantId),
                            quantity: 1,
                            properties: { 
                                '_temp_parent_nonce': nonce,
                                '_is_parent': true,
                                '_parent_id': nonce
                            }
                        })
                    });

                    // 2) Fetch cart and find the newly added parent line item by the nonce
                    const cartRes = await fetch('/cart.js', { credentials: 'same-origin' });
                    const cart = await cartRes.json();
                    const parentLine = cart.items.find(i => i.variant_id == Number(parentVariantId) && i.properties && i.properties._temp_parent_nonce == String(nonce));

                    if(!parentLine) {
                        // Fallback: try to find most recent matching variant
                        const fallbackLine = cart.items.slice().reverse().find(i => i.variant_id == Number(parentVariantId));
                        if(fallbackLine) parentLine = fallbackLine;
                    }

                    if(!parentLine || !parentLine.key) {
                        // Could not locate parent line key — fall back to normal submit
                        form.submit();
                        return;
                    }

                    const parentKey = parentLine.key;
                    let propertiesAddon = {
                        items: []
                    };
                    let chosenPlanter = document.querySelector('.pdpb-planter.active');
                    let chosenSaucer = document.querySelector('.pdpb-saucer.active');
                    let chosenColor = document.querySelector('.pdpb-color.hidden');
                    if(chosenPlanter) {
                        propertiesAddon.items.push({
                            id: Number(planterId),
                            quantity: 1,
                            parent_line_key: parentKey,
                            properties: {
                                '_parent_id': nonce,
                                'For': "{{ product.title | escape }}"
                            }
                        })
                    }
                    let planterCheck = document.querySelector('.planter-accordion-wrapper');
                    if(chosenSaucer) {
                        if(planterCheck) {
                            let ids = chosenSaucer.dataset.saucerVariant.split('|');
                            let colors = JSON.parse(atob(chosenSaucer.dataset.saucerColor));
                            let prices = chosenSaucer.dataset.saucerPrice.split('|').map(Number);
                            let checkColor = document.querySelector('.color-title-holder');
                            let saucerMap = [];
                            colors.forEach((color, i) => {
                                saucerMap.push({
                                    color: color,
                                    id: ids[i],
                                    price: prices[i],
                                });
                            });
                            let result = saucerMap.find(item => pdpNormColor(item.color) === pdpNormColor(checkColor.innerHTML));
                            // Fall back to the saucer's first variant when no colour is chosen/matched.
                            let saucerId = result ? (Number(result.id) || 0) : (Number(ids[0]) || 0);
                            propertiesAddon.items.push({
                                id: Number(saucerId),
                                quantity: 1,
                                parent_line_key: parentKey,
                                properties: {
                                    '_parent_id': nonce,
                                    'For': "{{ product.title | escape }}"
                                }
                            })
                        } else {
                            if(chosenColor) {
                                propertiesAddon.items.push({
                                    id: Number(planterId),
                                    quantity: 1,
                                    parent_line_key: parentKey,
                                    properties: {
                                        '_parent_id': nonce,
                                        'For': "{{ product.title | escape }}"
                                    }
                                })
                            } else {
                                var planterIdFirst = document.querySelectorAll('.pdpb-color')[0] ? document.querySelectorAll('.pdpb-color')[0].getAttribute("data-variant") : null;
                                propertiesAddon.items.push({
                                    id: Number(planterIdFirst),
                                    quantity: 1,
                                    parent_line_key: parentKey,
                                    properties: {
                                        '_parent_id': nonce,
                                        'For': "{{ product.title | escape }}"
                                    }
                                })
                            }
                        }
                    }
                    {% comment %} if(saucerTitle.innerHTML === 'Matching Saucer included') {
                        propertiesAddon = {
                            id: Number(planterId),
                            quantity: 1,
                            parent_line_key: parentKey
                        }
                    } else {
                        propertiesAddon = {
                            items: [
                            {
                                id: Number(saucerId),
                                quantity: 1,
                                parent_line_key: parentKey
                            },
                            {
                                id: Number(planterId),
                                quantity: 1,
                                parent_line_key: parentKey
                            }
                            ]
                        }
                    } {% endcomment %}
                    // 3) Add saucer as child using parent_line_key (per completePacking pattern)
                    await fetch('/cart/add.js', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(propertiesAddon)
                    });
                    // 4) Redirect to cart to show both items
                    $360.showHeaderCart();
                    buttons.forEach((buttonnode) => {
                        buttonnode.innerHTML = prev_text;
                    });
                    // window.location.href = location.origin + location.pathname + '?drawer=true';
                } catch(err) {
                    console.error('submitForm failed, falling back to normal submit', err);
                    form.submit();
                }
            }
        },
        mounted() {
            // Check initial variant availability on page load
            const initialVariant = this.product.variants.find(v => v.id === this.variantId);
            const pdp_top_atc_nodes = document.querySelectorAll('.pdp-top-atc');
            console.log('test this', '{{ variant.available }}');
            if(pdp_top_atc_nodes && pdp_top_atc_nodes.length && initialVariant != null) {
                pdp_top_atc_nodes.forEach((node) => {
                    if(!initialVariant.available) {
                        node.classList.add('disabled');
                        node.setAttribute('disabled', true);
                        if(node.querySelector('.atc-title')){
                            node.querySelector('.atc-title').innerHTML = "Sold Out";
                        }
                    } else {
                        {% if product.gift_card? or product.type == 'Gift Card' %}
                            const productTitle = document.querySelector('.product-title');
                            if (productTitle && productTitle.classList.contains('available')) {
                                node.classList.remove('disabled');
                                node.removeAttribute('disabled');
                                if(node.querySelector('.atc-title')){
                                    node.querySelector('.atc-title').innerHTML = "Add to Cart";
                                }
                            }
                        {% endif %}
                    }
                });
            }
            {% unless product.tags contains 'plants' %}
                const variantava = '{{ variant.id }}';
                if(variantava) {
                    history.replaceState({}, '', `?variant=${variantava}`);
                }
            {% endunless %}
        }
    }).mount('#{{ el_id }}');

    // Initial sold-out pass once the app is mounted: marks statically-rendered colours,
    // generic option values, and any fully-out-of-stock planters/saucers.
    try { applyOOS(); } catch (e) {}
</script>

