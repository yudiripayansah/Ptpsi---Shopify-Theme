            const swiper = swiperPop{{fn}};
            const nextBtn = document.querySelector('.arrow-container-popup .right');
            const prevBtn = document.querySelector('.arrow-container-popup .left');

            swiper.setTransition(400);

            function getSlideWidth() {
                return swiper.slides[swiper.activeIndex].offsetWidth;
            }

            if (nextBtn && prevBtn) {

                nextBtn.addEventListener('click', () => {
                    swiper.setTransition(400);

                    const slideWidth = getSlideWidth();
                    const viewport = swiper.width;
                    const cutOffset = slideWidth - viewport;

                    const currentTranslate = swiper.translate;
                    const targetPartial = -swiper.activeIndex * slideWidth;
                    const targetFull = targetPartial - cutOffset;

                    // If we're closer to partial → go to full
                    if (Math.abs(currentTranslate - targetPartial) < Math.abs(currentTranslate - targetFull)) {
                        swiper.setTranslate(targetFull);
                    } 
                    // Else go to next slide (partial)
                    else {
                        swiper.slideNext();
                        return;
                    }

                    swiper.updateProgress();
                    swiper.updateActiveIndex();
                    swiper.updateSlidesClasses();
                });

                prevBtn.addEventListener('click', () => {
                    swiper.setTransition(400);

                    const slideWidth = swiper.slides[swiper.activeIndex].offsetWidth;
                    const viewport = swiper.width;
                    const cutOffset = slideWidth - viewport;

                    const currentTranslate = swiper.translate;
                    const index = swiper.activeIndex;

                    const targetPartial = -index * slideWidth;
                    const targetFull = targetPartial - cutOffset;

                    // If currently closer to partial → go to previous slide FULL
                    if (Math.abs(currentTranslate - targetPartial) < Math.abs(currentTranslate - targetFull)) {
                        if (index > 0) {
                            const prevIndex = index - 1;
                            const prevSlideWidth = swiper.slides[prevIndex].offsetWidth;
                            const prevPartial = -prevIndex * prevSlideWidth;
                            const prevFull = prevPartial - (prevSlideWidth - viewport);

                            swiper.setTranslate(prevFull);
                            swiper.activeIndex = prevIndex;
                        }
                    }
                    // Else go from full → partial (same slide)
                    else {
                        swiper.setTranslate(targetPartial);
                    }

                    swiper.updateProgress();
                    swiper.updateActiveIndex();
                    swiper.updateSlidesClasses();
                });
            }
