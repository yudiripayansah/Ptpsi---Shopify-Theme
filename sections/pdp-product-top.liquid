    // Handle gift-card value selection: update UI and select matching variant
    function selectGiftVariant(e, pushUrlParam) {
        try {
            const tgt = (e && e.target) ? (e.target.closest('.pdpb-gc') || e.target) : null;
            if (!tgt) return;
            const vid = tgt.getAttribute('data-variant-id') || tgt.dataset.variantId || null;
            const vtitle = tgt.getAttribute('data-variant-title') || (tgt.querySelector('p') ? tgt.querySelector('p').innerText.trim() : '');

            // UI: mark active
            document.querySelectorAll('.pdpb-gc').forEach(el => el.classList.remove('hidden'));
            tgt.classList.add('hidden');

            // Update size/title holder if present
            const gcHolder = document.querySelector('.gc-title-holder');
            if (gcHolder) gcHolder.innerHTML = vtitle;

            // Try to find variant in the product JSON and update selection
            const variants = (window.pdpProductTop && window.pdpProductTop.product && Array.isArray(window.pdpProductTop.product.variants)) ? window.pdpProductTop.product.variants : [];
            let variant = null;
            if (vid) variant = variants.find(v => String(v.id) === String(vid));
            if (!variant && vtitle) variant = variants.find(v => String(v.title) === String(vtitle) || (v.title && v.title.indexOf(vtitle) >= 0));
            if (variant && window.pdpProductTop) {
                window.pdpProductTop.variantId = variant.id;
                window.pdpProductTop.first_load_check = false;
                // Update any variant input if present
                const pdp_top_variant_input = document.querySelector('.pdp-top-gift-form .pdp-top-variant-id');
                if (pdp_top_variant_input) pdp_top_variant_input.value = variant.id;

                // Update price displays
                const priceElems = document.querySelectorAll('.atc-button-price');
                priceElems.forEach((el) => {
                    if (!el) return;
                    el.innerHTML = `S$${(Number(variant.price) / 100).toFixed(2)}`;
                });

                // Enable/disable add-to-cart buttons for gift-card context based on availability
                try {
                    const atcButtons = document.querySelectorAll('.pdp-top-atc');
                    atcButtons.forEach((btn) => {
                        if (!variant.available) {
                            btn.classList.add('disabled');
                            btn.setAttribute('disabled', 'true');
                            btn.setAttribute('data-available', 'false');
                            btn.querySelector('.atc-title').innerHTML = "Sold Out";
                        } else {
                            const productTitle = document.querySelector('.product-title');
                            if (productTitle && productTitle.classList.contains('available')) {
                                btn.classList.remove('disabled');
                                btn.removeAttribute('disabled');
                                btn.setAttribute('data-available', 'true');
                                btn.querySelector('.atc-title').innerHTML = "Add to Cart";
                            }
                        }
                    });
                } catch (errAtc) {
                    console.warn('Failed to update ATC button state for gift variant', errAtc);
                }

                // Slide main swiper to this variant's image if possible (use data-variant-ids)
                setTimeout(() => {
                    const slides = Array.from(document.querySelectorAll('#{{ el_id }} .swiper-main .swiper-slide'));
                    let targetIndex = -1;
                    slides.forEach((slide, idx) => {
                        const vAttr = slide.getAttribute('data-variant-ids') || '';
                        if (!vAttr) return;
                        const ids = vAttr.split('|').map(s => s.trim()).filter(Boolean);
                        if (ids.indexOf(String(variant.id)) >= 0) targetIndex = idx;
                    });
                    if (targetIndex >= 0 && typeof swiper{{fn}} !== 'undefined' && swiper{{fn}}) {
                        swiper{{fn}}.slideTo(targetIndex);
                    }
                }, 80);

                // Update URL with selected variant: push on user actions, replace on programmatic calls
                try {
                    let pushUrl = true;
                    if (typeof pushUrlParam !== 'undefined') {
                        pushUrl = !!pushUrlParam;
                    } else if (e && typeof e === 'object' && typeof e.pushUrl !== 'undefined') {
                        pushUrl = !!e.pushUrl;
                    } else if (e && typeof e.isTrusted !== 'undefined') {
                        pushUrl = !!e.isTrusted;
                    }
                    const u = new URL(window.location.href);
                    u.searchParams.set('variant', variant.id);
                    if (pushUrl && history && history.pushState) {
                        history.pushState(null, null, u.toString());
                    } else if (history && history.replaceState) {
                        history.replaceState(null, null, u.toString());
                    }
                } catch (errUrl) {
                    // non-fatal
                }
            }
        } catch (err) {
            console.warn('selectGiftVariant failed', err);
        }
    }
