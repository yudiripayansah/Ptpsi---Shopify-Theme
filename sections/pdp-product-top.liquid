            if (nextBtn && prevBtn) {
                nextBtn.addEventListener('click', () => {
                    swiper.setTransition(400);
                    const maxTranslate = swiper.maxTranslate();
                    const nextTranslate = swiper.translate - swiper.width;

                    swiper.setTranslate(Math.max(nextTranslate, maxTranslate));
                    swiper.updateProgress();
                    swiper.updateActiveIndex();
                    swiper.updateSlidesClasses();
                });
                prevBtn.addEventListener('click', () => {
                    swiper.setTransition(400);
                    const minTranslate = swiper.minTranslate();
                    const prevTranslate = swiper.translate + swiper.width;

                    swiper.setTranslate(Math.min(prevTranslate, minTranslate));
                    swiper.updateProgress();
