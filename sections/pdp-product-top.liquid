    function initAccordions() {
        // Helper to recalculate collapsed/expanded heights for all accordions
        function recalcAccordionHeights() {
            document.querySelectorAll(".accordion").forEach((item) => {
                const header = item.querySelector('.pdpb-item-header');
                const body = item.querySelector('.pdpb-item-content');
                const hidden = item.querySelector('.pdpb-color');
                if (!header || !body) return;
                const collapsedHeight = header.offsetHeight;
                let expandedHeight;
                if (item.classList.contains('color-accordion')) {
                    expandedHeight = header.offsetHeight + body.scrollHeight - (hidden ? hidden.scrollHeight : 0);
                } else {
                    expandedHeight = header.offsetHeight + body.scrollHeight;
                }
                // store computed heights so we can use them without stale values
                item.dataset.collapsedHeight = collapsedHeight;
                item.dataset.expandedHeight = expandedHeight;
                // set initial height depending on open state
                if (!item.classList.contains('open')) {
                    let emptyCheck = item.querySelectorAll(".pdpb-item-content .pdpb-planters .pdpb-color");
                    let emptyCheckVal = false;
                    emptyCheck.forEach((empty) => {
                        if (!empty.classList.contains("hidden")) {
                            emptyCheckVal = true;
                        }
                    });
                    if (emptyCheckVal) {
                        item.style.height = collapsedHeight + 'px';
                        item.style.overflow = 'hidden';
                    }
                } else {
                    item.style.height = expandedHeight + 'px';
                    item.style.overflow = 'visible';
                }
            });
        }
        // ensure heights are correct on init
        recalcAccordionHeights();
        document.querySelectorAll(".accordion").forEach((item) => {
            let header = item.querySelector('.pdpb-item-header');
            let body = item.querySelector('.pdpb-item-content');
            let hidden = item.querySelector('.pdpb-color');
            
            if (!header || !body) return;

            item.closest('.accordion-wrapper').addEventListener('click', (event) => {
                console.log('accordion click');
                if (event.target.closest('.pdpb-item-content')) return;
                // Recalculate heights because header/body may have changed (e.g. planter swap)
                recalcAccordionHeights();
                const collapsedHeight = Number(item.dataset.collapsedHeight) || header.offsetHeight;
                const expandedHeight = Number(item.dataset.expandedHeight) || (header.offsetHeight + body.scrollHeight);

                document.querySelectorAll(".accordion").forEach((itemLow) => {
                    if (itemLow !== item) {
                        itemLow.classList.remove('open');
                        const ch = Number(itemLow.dataset.collapsedHeight) || (itemLow.querySelector('.pdpb-item-header') ? itemLow.querySelector('.pdpb-item-header').offsetHeight : 0);
                        itemLow.style.height = ch + 'px';
                        itemLow.style.overflow = 'hidden';
                    }
                });
                let emptyCheck = item.querySelectorAll(".pdpb-item-content .pdpb-planters .pdpb-color");
                let emptyCheckVal = false;
                emptyCheck.forEach((empty) => {
                    if (!empty.classList.contains("hidden")) {
                        emptyCheckVal = true;
                    }
                });
                if(emptyCheck.length) {
                    if (emptyCheckVal) {
                        item.classList.toggle('open');
                    }
                } else {
                    item.classList.toggle('open');
                }

                if (item.classList.contains('open')) {
                    item.style.height = expandedHeight + 'px';
                    if(item.classList.contains('accordion-color')) {
                        setTimeout(() => {
                            item.style.overflowY = 'auto';
                        }, 300);
                    } else {
                        setTimeout(() => {
                            item.style.overflow  = 'visible';
                        }, 300);
                    }
                } else {
                    item.style.height = collapsedHeight + 'px';
                    item.style.overflow = 'hidden';
                }
            });
        });
