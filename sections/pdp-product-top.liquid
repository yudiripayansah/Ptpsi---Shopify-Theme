        // Function to update saucer list based on selected planter
        function updateSaucerList(colorHash, matching) {
            const saucerContainer = document.querySelector('.saucer-accordion-wrapper .pdpb-item-content .pdpb-planters');
            const saucerContainerWrapper = document.querySelector('.saucer-accordion-wrapper');
            if (!saucerContainer) return;
            
            // Reset saucer header display
            const saucerTitleHolder = document.querySelector('.saucer-title-holder');
            const saucerImageHolder = document.querySelector('.saucer-image-holder');
            if (saucerTitleHolder) {
                if(matching) {
                    saucerTitleHolder.innerHTML = 'Matching Saucer included';
                } else {
                    saucerTitleHolder.innerHTML = 'Select Saucer';
                }
            }
            if (saucerImageHolder) {
                saucerImageHolder.innerHTML = '';
            }
            
            // Remove active state from all saucers
            document.querySelectorAll(".pdpb-saucer").forEach((saucer) => {
                saucer.classList.remove('active');
            });

            // Reset ATC price to base when planter changes (update all price elements)
            const atcPriceElems = document.querySelectorAll('.atc-button-price');
            if (atcPriceElems && atcPriceElems.length) {
                atcPriceElems.forEach((el) => {
                    const baseData = el.getAttribute('data-price') || el.dataset.price || '';
                    const basePrice = Number(baseData) || 0;
                    el.innerHTML = `S$${(basePrice / 100).toFixed(2)}`;
                });
            }

            // Clear existing saucers
            saucerContainer.innerHTML = '';
            
            // Find the matching planter and get its saucer IDs
            const allPlanters = document.querySelectorAll('.pdpb-planter');
            let saucersFound = false;
            let saucersAdded = 0;

            const saucerHolder = document.querySelector('.saucer-change-holder');
            if (!saucerHolder) return;
            console.log(JSON.parse(saucerHolder.textContent));
            let saucers;
            try {
            saucers = JSON.parse(saucerHolder.textContent);
            } catch (e) {
            console.error('Invalid saucer JSON', e);
            return;
            }

            let productsSaucers = saucers.map(saucer => {
                let availability = Array.isArray(saucer.variants)
                ? saucer.variants.map(v => v.available).join('|')
                : '';
                let variantIds = Array.isArray(saucer.variants)
                ? saucer.variants.map(v => v.id).join('|')
                : '';
                let colors = Array.isArray(saucer.variants)
                ? saucer.variants.map(v => v.option1).join('|')
                : '';
                let colors64 = Array.isArray(saucer.variants)
                ? btoa(JSON.stringify(saucer.variants.map(v => v.option1)))
                : '';
                let prices = Array.isArray(saucer.variants)
                ? saucer.variants.map(v => v.price).join('|')
                : '';
            return {
                id: saucer.id,
                handle: saucer.handle,
                title: saucer.title,
                url: saucer.url,
                colors: colors,
                colors64: colors64,
                variantId: variantIds,
                price: prices,
                availability: availability
            };
            });

            productsSaucers.forEach((saucer) => {
                console.log(saucer);
                let matchesColor =
                    !colorHash || saucer.colors.split('|').includes(colorHash);
                if (saucer) {
                    if (!matchesColor) return;
                    if (fetchSaucerDetails(saucer)) {
                        saucersAdded++;
                    }
                    saucersFound = true;
                }
            });

            
            // Re-initialize saucer click handlers after all saucers are added
            if (saucersAdded > 0) {
                saucerContainerWrapper.classList.remove('hide-m');
                initSaucerHandlers();
            }

            // Ensure accordion heights are recalculated after DOM changes
            if (typeof window.recalcAccordionHeights === 'function') {
                // run on next microtask to ensure DOM updates applied
                Promise.resolve().then(() => window.recalcAccordionHeights());
            }
        }
        
        // Global saucer data map (will be populated from Liquid)
        window.saucerDataMap = window.saucerDataMap || {};
        
        // Function to populate saucer element from preloaded data (no client fetch)
        function fetchSaucerDetails(product) {
            if (!window.saucerDataMap) {
                console.warn('Saucer data map not initialized');
                return false;
            }
            console.log('fetchSaucerDetails called for', product.title);

            const saucer = window.saucerDataMap[product.title];

            const saucerEl = document.createElement('button');
            saucerEl.className = 'pdpb-list pdpb-saucer relative';

            // Use preloaded variantId and price (price stored as integer cents)
            if (product.variantId) {
                saucerEl.setAttribute('data-saucer-variant', product.variantId);    
            }
            console.log('checksauceragain', product.colors64);
            if (product.colors64) {
                saucerEl.setAttribute('data-saucer-color', product.colors64);
            }
            if (product.price) {
                saucerEl.setAttribute('data-saucer-price', product.price);
            }
            saucerEl.setAttribute('data-availability', product.availability);
            


            saucerEl.innerHTML = `
                <p class="absolute bg-main pt-4 pb-4 pl-8 pr-8 p3">${product.title}</p>
                <span class="flex">${saucer.svg}</span>
            `;
            document.querySelector('.saucer-accordion-wrapper .pdpb-item-content .pdpb-planters').appendChild(saucerEl);
            return true;
        }
        
