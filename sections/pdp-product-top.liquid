        if(screen.width > 1023) {
            const cursorIcon = document.querySelector('.icon-zoom');
            const hoverZone = document.querySelector('.swiper-main');
            const excludeEl = document.querySelector('.arrow-container');

            if (!cursorIcon || !hoverZone || !excludeEl) return;

            let mouseX = null;
            let mouseY = null;
            let active = false;
            let initialized = false;

            // Activate helper
            function activate(e) {
                mouseX = e.clientX;
                mouseY = e.clientY;

                cursorIcon.style.transform =
                    `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;

                cursorIcon.style.display = 'block';
                document.body.style.cursor = 'none';
                active = true;
            }

            // Deactivate helper
            function deactivate() {
                active = false;
                cursorIcon.style.display = 'none';
                document.body.style.cursor = 'default';
            }

            // Global mouse tracking
            document.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;

                // Handle "already inside on load"
                if (!initialized) {
                    initialized = true;

                    const rect = hoverZone.getBoundingClientRect();
                    const inside =
                        e.clientX >= rect.left &&
                        e.clientX <= rect.right &&
                        e.clientY >= rect.top &&
                        e.clientY <= rect.bottom;

                    if (inside) activate(e);
                }

                if (!active) return;

                // Exclude zone check
                const r = excludeEl.getBoundingClientRect();
                const hoveringExclude =
                    e.clientX >= r.left &&
                    e.clientX <= r.right &&
                    e.clientY >= r.top &&
                    e.clientY <= r.bottom;

                cursorIcon.style.display = hoveringExclude ? 'none' : 'block';
            });

            // Hover zone enter / leave
            hoverZone?.addEventListener('mouseenter', (e) => {
                activate(e);
            });

            hoverZone?.addEventListener('mouseleave', () => {
                deactivate();
            });

            // Animation loop
            function animate() {
                if (active && mouseX !== null && cursorIcon.style.display !== 'none') {
                    cursorIcon.style.transform =
                        `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;
                }
                requestAnimationFrame(animate);
            }
            animate();
