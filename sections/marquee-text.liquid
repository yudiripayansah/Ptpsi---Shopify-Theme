{% comment %} Soilboy {% endcomment %}
{% liquid
  assign fn = section.id | replace: '-', ''
  assign el_id = 'marquee-text' | append: section.id
  assign ss = section.settings
  assign sb = section.blocks
  render 'section-padding', el_id: el_id, section: section
%}

<style>
      #{{ el_id }} {
          background-color: {{ section.settings.bg_color }};
      }

      #{{ el_id }} .marquee {
          width: 100%;
          overflow: hidden;
          white-space: nowrap;
          box-sizing: border-box;
          color: #333;
      }
      #{{ el_id }} .marquee span {
          display: inline-block;
          padding-left: 100%;
          animation: marquee {{ section.settings.duration }}s linear infinite;
      }

      @media screen and (min-width: 1024px){

  }
      @keyframes marquee {
          0%   { transform: translateX(0%); }
          100% { transform: translateX(-100%); }
      }
</style>

{% if request.visual_preview_mode %}
  <img src="{{ 'marquee-text-figma.png' | asset_url }}" width="100%" height="100%" />
{% else %}
  <div id="{{ el_id }}">
    <div class="marquee pb-24 d-pb-32 pt-24 d-pt-32">
      <span class="{{ section.settings.text_size }} no-anim c-main">{{ section.settings.text }}</span>
    </div>
  </div>
{% endif %}

