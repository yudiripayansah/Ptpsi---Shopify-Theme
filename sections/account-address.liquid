  <script>
    function validate(e, submit = false) {
      console.log(e);
      e.preventDefault();
      let form = e.target.closest('form');
      let error_firstName = "{{ 'customer.register.required_field' | t }}";
      let error_lastName = "{{ 'customer.register.required_field' | t }}";
      let error_address1 = "{{ 'customer.addresses.address_error' | t }}";
      // let error_address2 = "{{ 'customer.addresses.address_error' | t }}";
      // let error_city = "{{ 'customer.register.required_field' | t }}";
      let error_zip = "{{ 'customer.register.required_field' | t }}";
      // let error_phone = "{{ 'customer.register.required_field' | t }}";
      let firstName = form.querySelector('input[name="address[first_name]"]');
      let lastName = form.querySelector('input[name="address[last_name]"]');
      let address1 = form.querySelector('input[name="address[address1]"]');
      // let address2 = form.querySelector('input[name="address[address2]"]');
      // let city = form.querySelector('input[name="address[city]"]');
      let zip = form.querySelector('input[name="address[zip]"]');
      // let phone = form.querySelector('input[name="address[phone]"]');
      let elErrorfirstName = form.querySelector('.error-first-name');
      let elErrorlastName = form.querySelector('.error-last-name');
      let elErroraddress1 = form.querySelector('.error-address1');
      // let elErroraddress2 = form.querySelector('.error-address2');
      // let elErrorcity = form.querySelector('.error-city');
      let elErrorzip = form.querySelector('.error-zip');
      // let elErrorphone = form.querySelector('.error-phone');
      let submitBtn = form.querySelector('.submit-btn');
      let allOk = true;
      if (
        firstName.value &&
        lastName.value &&
        address1.value &&
        // address2.value &&
        // city.value &&
        zip.value
        // phone.value
      ) {
        if (allOk) {
          elErrorfirstName.classList.add('hide-m');
          elErrorlastName.classList.add('hide-m');
          elErroraddress1.classList.add('hide-m');
          // elErroraddress2.classList.add('hide-m');
          // elErrorcity.classList.add('hide-m');
          elErrorzip.classList.add('hide-m');
          // elErrorphone.classList.add('hide-m');
          submitBtn.removeAttribute('disabled');
          if (submit) {
            form.submit();
          }
        }
      } else {
        if (!firstName.value) {
          elErrorfirstName.innerText = error_firstName;
          elErrorfirstName.classList.remove('hide-m');
        } else {
          elErrorfirstName.classList.add('hide-m');
        }
        if (!lastName.value) {
          elErrorlastName.innerText = error_lastName;
          elErrorlastName.classList.remove('hide-m');
        } else {
          elErrorlastName.classList.add('hide-m');
        }
        if (!address1.value) {
          elErroraddress1.innerText = error_address1;
          elErroraddress1.classList.remove('hide-m');
        } else {
          elErroraddress1.classList.add('hide-m');
        }
        {% comment %} if (!address2.value) {
          elErroraddress2.innerText = error_address2;
          elErroraddress2.classList.remove('hide-m');
        } else {
          elErroraddress2.classList.add('hide-m');
        } {% endcomment %}
        {% comment %} if (!city.value) {
          elErrorcity.innerText = error_city;
          elErrorcity.classList.remove('hide-m');
        } else {
          elErrorcity.classList.add('hide-m');
        } {% endcomment %}
        if (!zip.value) {
          elErrorzip.innerText = error_zip;
          elErrorzip.classList.remove('hide-m');
        } else {
          elErrorzip.classList.add('hide-m');
        }
        {% comment %} if (!phone.value) {
          elErrorphone.innerText = error_phone;
          elErrorphone.classList.remove('hide-m');
        } else {
          elErrorphone.classList.add('hide-m');
        } {% endcomment %}
        submitBtn.setAttribute('disabled', true);
      }
    }
    function toggleAddressForm(e, addressId = null) {
      e.preventDefault();
      let displayTable = document.querySelector('.aa-table');
      let mainDisplay = document.querySelector('.main-display');
      let addressBack = document.querySelector('.address-back-link');
      let menuForm = document.querySelector('.address-popup-teleport');
      let submitBtn = document.querySelector('.aa-btn');
      let forms = document.querySelectorAll('.ac-form');
      let titles = document.querySelectorAll('.title-top');
      let formsWrapper = document.querySelectorAll('.ac-form-wrapper');
      let targetForm = document.querySelector('.ac-form-new');
      document.querySelectorAll(`.each-address-wrapper-left`).forEach(function (elem) {
        elem.classList.remove('hide-m');
      });
      titles.forEach(function (title) {
        title.classList.add('hide-m');
      });
      {% comment %} document.querySelectorAll(`.each-address-wrapper-right`).forEach(function (elemr) {
        elemr.classList.remove('hide-m');
      }); {% endcomment %}
      {% comment %} document.querySelectorAll(`.ac-form-mobile`).forEach(function (elemr) {
        elemr.classList.remove('hide-m');
      }); {% endcomment %}
      if (addressId) {
        document.querySelector('.title-edit').classList.remove('hide-m');
        displayTable.classList.remove('hide-m');
        mainDisplay.classList.remove('flex');
        mainDisplay.classList.add('hide-m');
        addressBack.classList.add('flex');
        addressBack.classList.remove('hide-m');
        menuForm.classList.add('hide-m');
        submitBtn.classList.remove('display-inline');
        submitBtn.classList.add('hide-m');
        let targetFormEdit = document.querySelector('.ac-form-edit-' + addressId);
        let targetFormMobileEdit = document.querySelector('.ac-form-edit-mobile-' + addressId);
        // let targetleft = targetForm.closest('td').closest('tr').querySelector('.each-address-wrapper-left');
        // let targetright = targetForm.closest('td').closest('tr').querySelector('.each-address-wrapper-right');
        // let targetmobile = targetFormMobile.closest('td').closest('tr').querySelector('.ac-form-mobile');
        // targetright.classList.add('hide-m');
        // targetleft.classList.add('hide-m');
        // targetmobile.classList.add('hide-m');
        formsWrapper.forEach((item) => {
          item.classList.add('hide-m');
        });
        targetFormEdit.classList.remove('hide-m');
        targetFormMobileEdit.classList.remove('hide-m');
      } else {
        formsWrapper.forEach((item) => {
          item.classList.add('hide-m');
        });
        if(e.target.classList.contains('aa-btn')) {
          document.querySelector('.title-add').classList.remove('hide-m');
          displayTable.classList.add('hide-m');
          addressBack.classList.add('flex');
          addressBack.classList.remove('hide-m');
          menuForm.classList.remove('hide-m');
          submitBtn.classList.remove('display-inline');
          targetForm.classList.remove('hide-m');
        } else {
          document.querySelector('.title-default').classList.remove('hide-m');
          displayTable.classList.remove('hide-m');
          addressBack.classList.remove('flex');
          addressBack.classList.add('hide-m');
          mainDisplay.classList.add('flex');
          mainDisplay.classList.remove('hide-m');
          menuForm.classList.add('hide-m');
          submitBtn.classList.add('display-inline');
        }
      }
    }
    const accountAddress = Vue.createApp({
      delimiters: ['${', '}'],
      data() {
        return {};
      },
      methods: {},
    }).mount('#{{el_id}} .address-popup-teleport');
  </script>
{% else %}
