{% comment %}
  Leadership/team grid — added because the reference site had no team section despite being
  a relationship-driven distribution business. Team members are classic section blocks.
{% endcomment %}

<section
  class="company-team mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="mx-auto max-w-2xl text-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="font-[Montserrat,sans-serif] text-2xl font-extrabold tracking-tight sm:text-3xl">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="mt-4 text-sm leading-relaxed opacity-70 sm:text-base">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}
  </div>

  <div data-reveal class="mt-10 grid grid-cols-2 gap-6 sm:mt-14 sm:grid-cols-4 sm:gap-8">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {% render 'company-team-card', name: block.settings.name, role: block.settings.role, image: block.settings.image %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .reveal-ready [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-ready [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-ready [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

<script src="{{ 'scroll-reveal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Team",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The people behind PSI" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A leadership team with the category expertise and relationships to grow every brand we carry."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffeeee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Jane Doe" },
        { "type": "text", "id": "role", "label": "Role", "default": "Managing Director" },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team",
      "blocks": [{ "type": "member" }]
    }
  ]
}
{% endschema %}
