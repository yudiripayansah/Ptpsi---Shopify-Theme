{% comment %}
  Distribution network band: map/image on one side, copy + CTA on the other — matches the
  reference's cream "DISTRIBUTION" panel. Split out from a combined section so this and
  Portfolio can each carry their own background/text color.
{% endcomment %}

<section
  class="company-distribution w-full"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-8 px-5 py-14 sm:px-8 sm:py-20 md:grid-cols-2 md:gap-12">
    <div class="aspect-[4/3] w-full overflow-hidden md:order-1">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 800
          | image_tag: widths: '400,800', class: 'h-full w-full object-contain', loading: 'lazy'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'h-full w-full opacity-30' }}
      {%- endif -%}
    </div>

    <div data-reveal class="md:order-2">
      <h2
        class="font-[Montserrat,sans-serif] text-sm font-extrabold uppercase tracking-widest sm:text-base"
        style="color: {{ section.settings.accent_color }};"
      >
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.body != blank -%}
        <div class="mt-4 max-w-md text-base leading-relaxed sm:text-lg">
          {{ section.settings.body }}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="mt-7">
          {% render 'company-button', label: section.settings.button_label, url: section.settings.button_link, bg: section.settings.accent_color, color: '#ffffff' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .reveal-ready [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-ready [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-ready [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

<script src="{{ 'scroll-reveal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Distribution",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Map / image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Distribution" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Our 11 major distributorships and 4 sub-distributorships span all major Indonesian cities: Bali, Balikpapan, Bandung, Batam, Jakarta, Lampung, Lombok, Makassar, Manado, Medan, Palembang, Papua, Semarang, Sorong, Surabaya.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find distributor" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffeeee" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent color (heading + button)", "default": "#880001" }
  ],
  "presets": [
    {
      "name": "Distribution"
    }
  ]
}
{% endschema %}
