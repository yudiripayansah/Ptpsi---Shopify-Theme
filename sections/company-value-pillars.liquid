{% comment %}
  "Why us" pillars: flat icon + bold uppercase label, no card chrome — matches the
  reference exactly. Pillars are classic section blocks so merchants can add/remove/reorder.
{% endcomment %}

<section
  class="company-pillars mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="mx-auto max-w-2xl text-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="font-[Montserrat,sans-serif] text-2xl font-extrabold tracking-tight sm:text-3xl">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
  </div>

  <div
    data-reveal
    class="company-pillars__grid mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:mt-14 sm:grid-cols-5 sm:gap-8"
  >
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {% render 'company-pillar-card', icon: block.settings.icon, title: block.settings.title, accent_color: section.settings.accent_color %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .reveal-ready [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-ready [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-ready [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

<script src="{{ 'scroll-reveal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Value pillars",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why PSI?"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon accent color",
      "default": "#d00507"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "passion", "label": "Passion" },
            { "value": "service", "label": "Service" },
            { "value": "loyalty", "label": "Loyalty" },
            { "value": "reliability", "label": "Reliability" },
            { "value": "leadership", "label": "Leadership" }
          ],
          "default": "passion"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Passion"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "passion", "title": "Passion" } },
        { "type": "pillar", "settings": { "icon": "service", "title": "Service excellence" } },
        { "type": "pillar", "settings": { "icon": "loyalty", "title": "Loyalty" } },
        { "type": "pillar", "settings": { "icon": "reliability", "title": "Reliability" } },
        { "type": "pillar", "settings": { "icon": "leadership", "title": "Market leader" } }
      ]
    }
  ]
}
{% endschema %}
