{% comment %} Soilboy {% endcomment %}
{% liquid
  assign el_id = 'how-it-works-parallax-' | append: section.id
  assign ss = section.settings
  assign sb = section.blocks

  assign total_d = 0
  assign total_m = 0
  for block in sb
    assign len_d = block.settings.scroll_length_d | default: 150
    assign len_m = block.settings.scroll_length_m | default: 125
    assign total_d = total_d | plus: len_d
    assign total_m = total_m | plus: len_m
  endfor
  assign track_d = total_d | plus: 100
  assign track_m = total_m | plus: 100

  assign media_type = ss.media_type | default: 'frames'

  comment
    Static mode: one shared image for the whole scroll, only the step
    descriptions change. Falls back to the first set's Image 1.
  endcomment
  assign static_image = blank
  if media_type == 'static'
    assign static_image = ss.static_image
    if static_image == blank
      assign static_image = sb.first.settings.image_1
    endif
  endif

  comment
    Video mode: one video for desktop and one for mobile, playing on their
    own; the scroll hold only drives the step descriptions.
  endcomment
  assign video_url_d = blank
  assign video_url_m = blank
  if media_type == 'video'
    for vid_source in ss.video_d.sources
      if vid_source.mime_type == 'video/mp4'
        assign video_url_d = vid_source.url
      endif
    endfor
    for vid_source in ss.video_m.sources
      if vid_source.mime_type == 'video/mp4'
        assign video_url_m = vid_source.url
      endif
    endfor
  endif
%}

<style>
  /* The track is a tall spacer; the stage sticks to the top of the viewport
     for its whole length, so the section "holds" while the sets play out.
     JS overwrites this height in px once it can measure the stage, these
     values only prevent a layout jump on first paint. */
  #{{ el_id }} {
    position: relative;
    height: {{ track_m }}vh;
    background-color: {{ ss.bg_color }};
  }
  #{{ el_id }} .hiw-stage {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  /* svh stays put when the mobile browser chrome hides, so the stage doesn't
     resize mid-scroll. JS measures the stage, so the track stays in step. */
  @supports (height: 100svh) {
    #{{ el_id }} .hiw-stage {
      height: 100svh;
    }
  }
  #{{ el_id }} .hiw-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  #{{ el_id }} .hiw-set {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  #{{ el_id }} .hiw-set:first-child {
    opacity: 1;
  }
  /* Frames stack in order and only the incoming one fades, so a dissolve
     never lets the background show through the pair. */
  {% if ss.frame_fit == 'cover' %}
    /* Full screen: frames carry their own background and fill the stage. */
    #{{ el_id }} .hiw-frame,
    #{{ el_id }} .hiw-video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  {% else %}
    #{{ el_id }} .hiw-frame,
    #{{ el_id }} .hiw-video {
      position: absolute;
      top: 46%;
      left: 50%;
      transform: translate(-50%, -50%);
      max-width: {{ ss.illustration_width_m | default: 92 }}%;
      max-height: 55%;
      width: auto;
      height: auto;
    }
  {% endif %}
  #{{ el_id }} .hiw-frame {
    opacity: 0;
  }
  #{{ el_id }} .hiw-frame:first-of-type {
    opacity: 1;
  }
  /* Device split: mobile frames replace desktop frames only in sets that
     actually have them; otherwise the desktop frames serve both. */
  #{{ el_id }} .hiw-set[data-has-mobile="true"] .hiw-frame--d {
    display: none;
  }
  {% if video_url_m != blank %}
    #{{ el_id }} .hiw-video--d {
      display: none;
    }
  {% endif %}
  #{{ el_id }} .hiw-header {
    position: absolute;
    top: 40px;
    left: 16px;
    right: 16px;
  }
  #{{ el_id }} .hiw-label {
    margin-bottom: 16px;
  }
  #{{ el_id }} .hiw-steps {
    position: absolute;
    bottom: 40px;
    left: 16px;
    right: 16px;
    display: grid;
  }
  #{{ el_id }} .hiw-step {
    grid-area: 1 / 1;
    align-self: end;
    opacity: 0;
    will-change: opacity;
  }
  #{{ el_id }} .hiw-step:first-child {
    opacity: 1;
  }
  #{{ el_id }} .hiw-step-num {
    flex: 0 0 auto;
  }
  #{{ el_id }} .hiw-step-text {
    margin-top: 8px;
  }
  @media screen and (min-width: 1024px) {
    #{{ el_id }} {
      height: {{ track_d }}vh;
    }
    {% unless ss.frame_fit == 'cover' %}
      #{{ el_id }} .hiw-frame,
      #{{ el_id }} .hiw-video {
        top: 47%;
        max-width: {{ ss.illustration_width | default: 42 }}%;
        max-height: 82%;
      }
    {% endunless %}
    #{{ el_id }} .hiw-frame--m,
    #{{ el_id }} .hiw-video--m {
      display: none;
    }
    #{{ el_id }} .hiw-set[data-has-mobile="true"] .hiw-frame--d {
      display: block;
    }
    {% if video_url_m != blank %}
      #{{ el_id }} .hiw-video--d {
        display: block;
      }
    {% endif %}
    #{{ el_id }} .hiw-header {
      top: auto;
      bottom: 60px;
      left: 24px;
      right: auto;
      width: 330px;
    }
    #{{ el_id }} .hiw-steps {
      bottom: 60px;
      left: auto;
      right: 24px;
      width: 566px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* No pin: the stage becomes one static panel with the first frame and
       every step listed, so nothing is lost. */
    #{{ el_id }} {
      height: auto !important;
    }
    #{{ el_id }} .hiw-stage {
      position: static;
      height: auto;
      padding: 48px 16px;
    }
    #{{ el_id }} .hiw-media {
      position: relative;
      height: auto;
    }
    #{{ el_id }} .hiw-set {
      position: relative;
      display: none;
      opacity: 1 !important;
    }
    #{{ el_id }} .hiw-set:first-child {
      display: block;
    }
    #{{ el_id }} .hiw-frame,
    #{{ el_id }} .hiw-video {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      display: none;
      margin: 0 auto;
      opacity: 1 !important;
      {% if ss.frame_fit == 'cover' %}
        width: 100%;
        height: auto;
        object-fit: contain;
      {% endif %}
    }
    #{{ el_id }} .hiw-frame:first-of-type,
    #{{ el_id }} .hiw-video:first-of-type {
      display: block;
    }
    #{{ el_id }} .hiw-header {
      position: static;
      width: auto;
      margin-bottom: 32px;
    }
    #{{ el_id }} .hiw-steps {
      position: static;
      display: block;
      width: auto;
      margin-top: 32px;
    }
    #{{ el_id }} .hiw-step {
      opacity: 1 !important;
    }
    #{{ el_id }} .hiw-step + .hiw-step {
      margin-top: 24px;
    }
  }
</style>

{% if request.visual_preview_mode %}
  <img src="{{ 'how-it-works-parallax-figma.png' | asset_url }}" width="100%" height="100%">
{% elsif sb.size > 0 %}
  <div id="{{ el_id }}" data-hiw-parallax data-mode="{{ media_type }}">
    <div class="hiw-stage">
      <div class="hiw-media">
        {% if media_type == 'video' %}
          {% if video_url_d != blank %}
            <video
              class="hiw-video hiw-video--d"
              data-src="{{ video_url_d }}"
              {% if ss.static_image != blank %}poster="{{ ss.static_image | image_url: width: 1600 }}"{% endif %}
              preload="none"
              muted
              loop
              playsinline
              webkit-playsinline
            ></video>
          {% endif %}
          {% if video_url_m != blank %}
            <video
              class="hiw-video hiw-video--m"
              data-src="{{ video_url_m }}"
              {% if ss.static_image != blank %}poster="{{ ss.static_image | image_url: width: 800 }}"{% endif %}
              preload="none"
              muted
              loop
              playsinline
              webkit-playsinline
            ></video>
          {% endif %}
        {% elsif media_type == 'static' %}
          {% if static_image != blank %}
            <div class="hiw-set" data-index="0">
              <img
                class="hiw-frame"
                data-src="{{ static_image | image_url: width: 2000 }}"
                width="{{ static_image.width }}"
                height="{{ static_image.height }}"
                alt="{{ static_image.alt | escape_once }}"
              >
            </div>
          {% endif %}
        {% else %}
          {% for block in sb %}
            {% liquid
              assign has_mobile = false
              for i in (1..30)
                assign image_key = 'image_m_' | append: i
                if block.settings[image_key] != blank
                  assign has_mobile = true
                  break
                endif
              endfor
            %}
            <div
              class="hiw-set"
              data-index="{{ forloop.index0 }}"
              data-has-mobile="{% if has_mobile %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% for i in (1..30) %}
                {% assign image_key = 'image_' | append: i %}
                {% assign frame = block.settings[image_key] %}
                {% if frame != blank %}
                  <img
                    class="hiw-frame hiw-frame--d"
                    data-src="{{ frame | image_url: width: 2000 }}"
                    width="{{ frame.width }}"
                    height="{{ frame.height }}"
                    alt="{{ frame.alt | escape_once }}"
                  >
                {% endif %}
              {% endfor %}
              {% for i in (1..30) %}
                {% assign image_key = 'image_m_' | append: i %}
                {% assign frame = block.settings[image_key] %}
                {% if frame != blank %}
                  <img
                    class="hiw-frame hiw-frame--m"
                    data-src="{{ frame | image_url: width: 1000 }}"
                    width="{{ frame.width }}"
                    height="{{ frame.height }}"
                    alt="{{ frame.alt | escape_once }}"
                  >
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="hiw-header">
        {% if ss.label != blank %}
          <p class="p3 no-anim c-label hiw-label">{{ ss.label }}</p>
        {% endif %}
        {% if ss.title != blank %}
          <{{ ss.title_dom_type }} class="{{ ss.title_size }} no-anim c-green">
            {{- ss.title | newline_to_br -}}
          </{{ ss.title_dom_type }}>
        {% endif %}
      </div>
      <div class="hiw-steps">
        {% for block in sb %}
          {% assign bs = block.settings %}
          <div
            class="hiw-step"
            data-index="{{ forloop.index0 }}"
            data-length-d="{{ bs.scroll_length_d | default: 150 }}"
            data-length-m="{{ bs.scroll_length_m | default: 125 }}"
          >
            {% if bs.title != blank %}
              <div class="flex ai-center colgap-8">
                <span class="p4 c-label hiw-step-num">
                  {%- if forloop.index < 10 %}0{% endif -%}
                  {{- forloop.index -}}
                </span>
                <span class="p1 c-green">{{ bs.title }}</span>
              </div>
            {% endif %}
            {% if bs.text != blank %}
              <div class="p2 c-green hiw-step-text">{{ bs.text | newline_to_br }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var SECTION_ID = '{{ el_id }}';
      var OVERLAP = 0.15; // share of a segment spent crossfading into the next set
      var FADE = 0.18;    // share of a segment spent fading a step description in / out

      function clamp(v, min, max) {
        return v < min ? min : (v > max ? max : v);
      }

      function initHiwParallax(root) {
        if (!root || root.hiwInited) return;
        root.hiwInited = true;

        var stage = root.querySelector('.hiw-stage');
        var steps = Array.prototype.slice.call(root.querySelectorAll('.hiw-step'));
        var sets = Array.prototype.slice.call(root.querySelectorAll('.hiw-set'));
        if (!stage || !steps.length) return;

        var mode = root.getAttribute('data-mode') || 'frames';
        var animateFrames = mode === 'frames';

        var stageH = 0;
        var isDesktop = false;
        var lengths = [];
        var frames = [];
        var total = 0;
        var ticking = false;
        var activeVideo = null;

        // Only the frames for the current breakpoint: mobile sets fall back
        // to the desktop frames when no mobile frames were uploaded.
        function framesFor(set) {
          if (!set) return [];
          var useMobile = !isDesktop && set.getAttribute('data-has-mobile') === 'true';
          var selector = useMobile
            ? '.hiw-frame--m'
            : '.hiw-frame--d, .hiw-frame:not(.hiw-frame--d):not(.hiw-frame--m)';
          return Array.prototype.slice.call(set.querySelectorAll(selector));
        }

        function loadSet(i) {
          var set = sets[i];
          if (!set) return;
          var flag = isDesktop ? 'hiwLoadedD' : 'hiwLoadedM';
          if (set[flag]) return;
          set[flag] = true;
          framesFor(set).forEach(function (img) {
            if (img.getAttribute('data-src')) {
              img.src = img.getAttribute('data-src');
              img.removeAttribute('data-src');
            }
          });
        }

        function pickVideo() {
          if (mode !== 'video') return null;
          var video = null;
          if (!isDesktop) video = root.querySelector('.hiw-video--m');
          if (!video) video = root.querySelector('.hiw-video--d');
          return video;
        }

        function loadVideo(allowPlay) {
          var video = pickVideo();
          if (!video) return;
          if (video !== activeVideo && activeVideo && !activeVideo.paused) {
            activeVideo.pause();
          }
          activeVideo = video;
          if (video.getAttribute('data-src')) {
            video.src = video.getAttribute('data-src');
            video.removeAttribute('data-src');
            video.load();
          }
          if (allowPlay && video.paused) {
            var playing = video.play();
            if (playing && playing.catch) playing.catch(function () {});
          }
        }

        function measure() {
          stageH = stage.offsetHeight;
          isDesktop = window.innerWidth >= 1024;
          frames = sets.map(framesFor);
          total = 0;
          lengths = steps.map(function (s) {
            var vh = parseFloat(s.getAttribute(isDesktop ? 'data-length-d' : 'data-length-m'));
            if (isNaN(vh) || vh <= 0) vh = 125;
            var px = (vh / 100) * stageH;
            total += px;
            return px;
          });
          // Track = all segments plus one stage, so the last set finishes
          // before the sticky stage lets go.
          root.style.height = (total + stageH) + 'px';
        }

        function update() {
          var rect = root.getBoundingClientRect();
          var inView = rect.top < window.innerHeight && rect.bottom > 0;
          var scrolled = clamp(-rect.top, 0, total);
          var index = steps.length - 1;
          var t = 1;
          var acc = 0;
          for (var i = 0; i < lengths.length; i++) {
            if (scrolled < acc + lengths[i] || i === lengths.length - 1) {
              index = i;
              t = lengths[i] ? clamp((scrolled - acc) / lengths[i], 0, 1) : 0;
              break;
            }
            acc += lengths[i];
          }

          if (mode === 'video') {
            // The video plays on its own; the scroll hold only swaps the text.
            if (activeVideo && activeVideo.src) {
              if (inView && activeVideo.paused) {
                var playing = activeVideo.play();
                if (playing && playing.catch) playing.catch(function () {});
              } else if (!inView && !activeVideo.paused) {
                activeVideo.pause();
              }
            }
          } else {
            loadSet(animateFrames ? index : 0);
            if (animateFrames) loadSet(index + 1);
          }

          if (animateFrames) {
            for (var b = 0; b < sets.length; b++) {
              // Sets below the active one stay opaque: the active set sits on
              // top of them, and that keeps scrolling backwards seamless.
              var opacity;
              if (b <= index) {
                opacity = 1;
              } else if (b === index + 1 && t > 1 - OVERLAP) {
                opacity = (t - (1 - OVERLAP)) / OVERLAP;
              } else {
                opacity = 0;
              }
              sets[b].style.opacity = opacity;
            }
            var active = frames[index];
            if (active && active.length) {
              var f = t * (active.length - 1);
              for (var k = 0; k < active.length; k++) {
                active[k].style.opacity = clamp(f - (k - 1), 0, 1);
              }
            }
          }

          for (var s = 0; s < steps.length; s++) {
            if (s !== index) {
              steps[s].style.opacity = 0;
              continue;
            }
            // First step starts visible so the page never lands on empty text;
            // the last step stays visible while the stage unpins.
            var fadeIn = s === 0 ? 1 : t / FADE;
            var fadeOut = s === steps.length - 1 ? 1 : (1 - t) / FADE;
            steps[s].style.opacity = clamp(Math.min(fadeIn, fadeOut), 0, 1);
          }
        }

        function onScroll() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function () {
            ticking = false;
            update();
          });
        }

        function onResize() {
          var wasDesktop = isDesktop;
          measure();
          if (mode === 'video') {
            loadVideo(true);
          } else if (isDesktop !== wasDesktop) {
            // Breakpoint changed: the visible device frames may still be lazy.
            for (var i = 0; i < sets.length; i++) {
              if (sets[i].hiwLoadedD || sets[i].hiwLoadedM) {
                sets[i][isDesktop ? 'hiwLoadedD' : 'hiwLoadedM'] = false;
                loadSet(i);
              }
            }
          }
          update();
        }

        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
          // CSS has already unpinned the section; just make sure the visible
          // media is actually loaded. Videos stay on their poster.
          root.style.height = 'auto';
          isDesktop = window.innerWidth >= 1024;
          if (mode === 'video') {
            loadVideo(false);
          } else {
            loadSet(0);
          }
          return;
        }

        measure();
        if (mode === 'video') {
          loadVideo(true);
        } else {
          loadSet(0);
        }
        update();

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
        window.addEventListener('orientationchange', onResize);
        window.addEventListener('load', onResize);

        root.hiwDestroy = function () {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onResize);
          window.removeEventListener('orientationchange', onResize);
          window.removeEventListener('load', onResize);
          if (activeVideo && !activeVideo.paused) activeVideo.pause();
        };
      }

      function boot() {
        initHiwParallax(document.getElementById(SECTION_ID));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }

      if (window.Shopify && window.Shopify.designMode) {
        document.addEventListener('shopify:section:load', function (event) {
          var el = event.target.querySelector('[data-hiw-parallax]');
          if (el) initHiwParallax(el);
        });
        document.addEventListener('shopify:section:unload', function (event) {
          var el = event.target.querySelector('[data-hiw-parallax]');
          if (el && el.hiwDestroy) el.hiwDestroy();
        });
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "How It Works Parallax",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2E9DF",
      "info": "Fills the whole stage. This is the background behind transparent PNG frames."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "info": "Stays on screen for the whole scroll, across all sets."
    },
    {
      "type": "select",
      "id": "title_dom_type",
      "label": "Title DOM Type",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title Font Size",
      "options": [
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        { "value": "frames", "label": "Image frames (scroll animated)" },
        { "value": "static", "label": "Static image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "frames",
      "info": "With Static image or Video, the scroll hold only changes the step descriptions."
    },
    {
      "type": "image_picker",
      "id": "static_image",
      "label": "Static Image",
      "info": "Used when Media Type is Static image (falls back to the first set's Desktop Frame 1). Also used as the video poster."
    },
    {
      "type": "video",
      "id": "video_d",
      "label": "Video (Desktop)",
      "info": "Used when Media Type is Video. Plays muted and looped, independent of the scroll."
    },
    {
      "type": "video",
      "id": "video_m",
      "label": "Video (Mobile)",
      "info": "Optional. Falls back to the desktop video."
    },
    {
      "type": "header",
      "content": "Media Display"
    },
    {
      "type": "select",
      "id": "frame_fit",
      "label": "Media Display",
      "options": [
        { "value": "contain", "label": "Centered illustration" },
        { "value": "cover", "label": "Full screen" }
      ],
      "default": "contain",
      "info": "Full screen: media fills the viewport (background baked in). Centered: media fits inside the screen — best with transparent-background frames over the Background Color."
    },
    {
      "type": "range",
      "id": "illustration_width",
      "label": "Illustration Max Width (Desktop)",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 42,
      "info": "Only used with Centered illustration."
    },
    {
      "type": "range",
      "id": "illustration_width_m",
      "label": "Illustration Max Width (Mobile)",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 92
    }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Set",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "info": "The step number is added automatically."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step Text"
        },
        {
          "type": "header",
          "content": "Desktop Frames"
        },
        {
          "type": "paragraph",
          "content": "Frames crossfade in order while this set holds the screen. Use images with the same dimensions. Empty slots are skipped."
        },
        { "type": "image_picker", "id": "image_1", "label": "Desktop Frame 1" },
