{% comment %} Soilboy {% endcomment %}
{% liquid
  assign fn = section.id | replace: '-', ''
  assign el_id = 'custom-liquid' | append: section.id
  assign ss = section.settings
  assign sb = section.blocks
  render 'section-padding', el_id: el_id, section: section
%}

<style>
  #{{ el_id }} {
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (min-width: 1024px){
  }
</style>

<div id="{{ el_id }}" class="relative">
  {{ ss.custom_liquid }}
</div>

{% schema %}
{
  "name": "Custom Liquid",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "html",
      "id": "custom_liquid",
      "label": "Custom Liquid",
      "info": "Add app snippets or custom Liquid code, to create advanced customization"
    },
    {
      "type": "header",
      "content": "Section Paddings"
    },
    {
      "type": "select",
      "id": "top_padding_m",
      "label": "Top padding (Mobile)",
