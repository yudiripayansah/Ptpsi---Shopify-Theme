{% comment %} Soilboy {% endcomment %}
{% liquid
  assign fn = section.id | replace: '-', ''
  assign el_id = 'collection-main-content'
  assign ss = section.settings
  assign sb = section.blocks
  render 'section-padding', el_id: el_id, section: section
  if request.page_type == 'collection'
    assign products_count = collection.products_count
    assign filters = collection.filters
    assign filter_mode = collection.metafields.custom.filter_mode.value
    assign filter_data = collection.metafields.custom.filters.value
    assign exclude_filters = ''
    if filter_mode != blank
      if filter_mode == 'exclude'
        assign exclude_filters = filter_data
      else 
        for filter in collection.filters
          unless filter_data contains filter.label 
            assign exclude_filters = exclude_filters | append: filter.label | append: '|' 
          endunless
        endfor
        assign exclude_filters = exclude_filters | split: '|'
      endif
    endif
  else 
    assign products_count = search.results_count 
    assign exclude_filters = ''
    assign filters = search.filters
  endif 
%}
