      }
      #{{el_id}} .products-outer-wrapper.col-six {
        margin: 0 -6px;
      }
      #{{el_id}} .products-outer-wrapper.col-six .product-col {
        width: calc(100% / 6);
        padding: 0 6px;
      }
      #{{el_id}} .empty-result-container {
        padding-bottom: 240px;
      }
      #collection-filter .filter-wrapper .main-filter {
        right: unset;
        left: -100%;
        width: 424px;
      }
      #collection-filter .filter-wrapper .main-filter.active-mobile {
        right: unset;
        left: 0;
      }
      #collection-filter .filter-wrapper .main-filter .each-filter-wrapper {
        padding: 16px 24px;
      }
      #collection-filter .filter-wrapper .main-filter .each-filter-wrapper {
        height: calc(100% - 142px);
      }
      #collection-filter .filter-wrapper,
      #collection-filter .sort-wrapper {
        width: calc((100% - 72px) / 4);
        order: 1;
      }
      #collection-filter .sort-wrapper {
        order: 3;
      }
      #collection-filter .filter-size-wrapper {
        width: calc((100% - 24px) / 2);
        order: 2;
      }
      #collection-filter .collection-filter-bar {
