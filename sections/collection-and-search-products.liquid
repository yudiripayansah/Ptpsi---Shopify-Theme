      #{{el_id}} .product-card-wrapper.full {
      }
      #{{el_id}} .product-card-wrapper.many {
        
      }
      #{{el_id}} .video-wrapper.h-full{
          height:calc(100% - 50px);
      }
      #{{el_id}} .product-col {
        padding: 0 12px;;
      }
      #{{el_id}} .products-outer-wrapper {
        margin: 0 -12px;
      }
      #{{el_id}} .products-outer-wrapper:has(.many) {
          margin: 0 -4px;
      }
      #{{el_id}} .products-outer-wrapper:has(.full) .banner-wrapper {
