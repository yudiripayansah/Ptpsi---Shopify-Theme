    "gifts_numbered_details": {
      "type": "split-numbered-details",
      "blocks": {
        "entry_bulk_orders": {
          "type": "entry",
          "settings": {
            "title": "Bulk Plant Orders",
            "text": "Order plants in bulk for your team, clients, or events. We curate healthy, design-led greenery at scale, handle the styling and packaging, and coordinate delivery so every recipient gets a gift that feels personal."
          }
        },
        "entry_branded_pots": {
          "type": "entry",
          "settings": {
            "title": "Custom-Branded Pots",
            "text": "Elevate your corporate gifts with a personal touch. Our planters can be custom engraved with your company logo, a special message, or a memorable date—turning every gift into a meaningful keepsake. Perfect for client appreciation, team milestones, or office décor that reflects your brand."
          }
        },
        "entry_plant_tags": {
          "type": "entry",
          "settings": {
            "title": "Branded Plant Tags",
            "text": "Add a finishing touch with plant tags customised to your brand. From logos to personalised messages, each tag makes your gift instantly recognisable and memorable."
          }
        }
      },
      "block_order": [
        "entry_bulk_orders",
        "entry_branded_pots",
        "entry_plant_tags"
