        "block_mission": {
          "type": "block",
          "settings": {
            "label": "Our mission is simple:",
            "text_1": "To inspire a sense of curiosity for the greener things in life.",
            "text_1_size": "h2",
            "text_1_v": "center",
            "text_1_align": "left",
            "text_2": "Every plant we choose, every pot we design, and every tip we share is rooted in that idea. Whether you're a first-time plant parent or a seasoned grower, we want you to discover the joy of watching something thrive under your care.",
            "text_2_size": "p1",
            "text_2_v": "bottom",
            "text_2_align": "left",
