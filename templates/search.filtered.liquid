{% layout none %}
{%- paginate search.results by 500 -%}
  {% if search.results == blank %}
    <div class="p1">{{ 'general.search.no_results_html' | t }} "{{ search.terms }}".</div>
    <div class="flex flex-column rowgap-12 d-mt-32 mt-24 d-max-330 w-full">
      <a href="/collections/all" class="no-search-collection-link p2 c-white bg-green b-1 b-green flex ai-center jc-between colgap-48 pt-12 pb-12 pl-24 pr-24">
        Shop All <span class="icon flex ai-center jc-center p-2">{{settings.icon_arrow_up_right}}</span>
      </a>
      <a href="/pages/contact-us" class="no-search-contact-link p2 c-green b-1 b-green flex ai-center jc-between colgap-48 pt-12 pb-12 pl-24 pr-24">
        Contact Us <span class="icon flex ai-center jc-center p-2">{{settings.icon_arrow_up_right}}</span>
      </a>
    </div>
  {% else %}
    {% assign total_product_result = 0 %}
    {%- for res in search.results -%}
      {% if res.object_type == 'product' %}
        {% assign total_product_result = total_product_result | plus: 1 %}
      {% endif %}
    {% endfor %}
    <div class="p3 c-label">Products</div>
    <div class="search-product-wrapper flex flex-wrap rowgap-16 colgap-16 mt-12 d-rowgap-24 d-colgap-24 d-mt-16">
      {% assign product_search_limit = 6 %}
      {%- for res in search.results -%}
        {% if res.object_type == 'product' %}
          {% assign product_search_limit = product_search_limit | minus: 1 %}
          <div class="search-product-each-wrapper">
            {%- render 'product-each', product: res, preload_image: true, hide_info_label: true, hide_color_option: true -%}
          </div>
        {% endif %}
        {% if product_search_limit == 0 %}{% break %}{% endif %}
      {%- endfor -%}
    </div>
  {% endif %}
  {%- if search.results.size > 0 -%}
    <div class="cursor search-view-all d-max-330 flex pt-12 pb-12 pl-24 pr-24 c-green b-1 b-green p2 c-green flex ai-center jc-between colgap-48 d-mt-32 mt-24">
      {{ 'general.search.view_all' | t }} ({{ total_product_result }}) <span class="icon flex ai-center jc-center p-2">{{settings.icon_arrow_up_right}}</span>
    </div>
  {%- endif -%}
{%- endpaginate -%}

