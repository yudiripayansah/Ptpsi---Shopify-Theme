{% doc %}
  Renders one flat "why us" value-pillar: a thin outline icon with a small red accent dot,
  and a bold uppercase label underneath. No card chrome — matches the reference's flat,
  icon-led list rather than boxed cards.

  @param {string} icon - Icon keyword: 'passion', 'service', 'loyalty', 'reliability', or 'leadership'
  @param {string} title - Pillar title
  @param {string} [accent_color] - Color of the small accent dot/star (defaults to brand red)

  @example
  {% render 'company-pillar-card', icon: 'passion', title: 'Passion' %}
{% enddoc %}

<div class="flex flex-col items-center gap-4 text-center">
  <span class="relative inline-flex h-14 w-14 items-center justify-center">
    {% case icon %}
      {% when 'passion' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full w-full" aria-hidden="true">
          <path d="M8 3v6a4 4 0 0 0 8 0V3" />
          <path d="M12 13v8M9 21h6" />
        </svg>
      {% when 'service' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full w-full" aria-hidden="true">
          <circle cx="12" cy="9" r="6" />
          <path d="M8.5 14.5L7 22l5-3 5 3-1.5-7.5" />
        </svg>
      {% when 'loyalty' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full w-full" aria-hidden="true">
          <path d="M20.8 8.6c0 5.4-8.8 10.4-8.8 10.4S3.2 14 3.2 8.6a4.6 4.6 0 0 1 8.8-1.8 4.6 4.6 0 0 1 8.8 1.8z" />
        </svg>
      {% when 'reliability' %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full w-full" aria-hidden="true">
          <path d="M12 3l8 3v6c0 4.5-3.4 7.7-8 9-4.6-1.3-8-4.5-8-9V6l8-3z" />
          <path d="M9 12l2 2 4-4" />
        </svg>
      {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full w-full" aria-hidden="true">
          <path d="M4 21V10h4v11M10 21V6h4v15M16 21v-8h4v8" />
        </svg>
    {% endcase %}
    <span class="absolute -right-0.5 -top-0.5 h-2.5 w-2.5 rounded-full" style="background-color: {{ accent_color | default: '#d00507' }};"></span>
  </span>

  <h3 class="font-[Montserrat,sans-serif] text-sm font-bold uppercase tracking-wide sm:text-base">{{ title }}</h3>
</div>
