{% doc %}
  Renders one leadership/team-member card: photo, name and role.

  @param {string} name - Person's name
  @param {string} role - Person's job title
  @param {image} [image] - Optional photo; falls back to a placeholder

  @example
  {% render 'company-team-card', name: 'Jane Doe', role: 'Managing Director', image: section.settings.team_1_image %}
{% enddoc %}

<div class="group flex flex-col items-center gap-3 text-center">
  <span class="aspect-square w-full max-w-[10rem] overflow-hidden rounded-2xl bg-neutral-100 sm:max-w-[11rem]">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 400
        | image_tag: widths: '200,400', class: 'h-full w-full object-cover transition duration-300 group-hover:scale-105', loading: 'lazy'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'h-full w-full text-neutral-300' }}
    {%- endif -%}
  </span>
  <span class="flex flex-col">
    <span class="font-[Montserrat,sans-serif] text-sm font-bold sm:text-base">{{ name }}</span>
    <span class="text-xs opacity-60 sm:text-sm">{{ role }}</span>
  </span>
</div>
